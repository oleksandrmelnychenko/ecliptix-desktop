<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ecliptix.Utilities\Ecliptix.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Core\Abstractions\**\*.cs"
             Link="Core/Abstractions/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Core\Modularity\**\*.cs"
             Link="Core/Modularity/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
