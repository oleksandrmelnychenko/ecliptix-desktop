<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Feature.Profile.Profile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:PersonalFavoritesViewModel"
             x:Class="Ecliptix.Feature.Profile.Profile.Views.PersonalFavoritesView">
    <Grid>
        <StackPanel IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">

            <Border Height="96" Width="96"
                    CornerRadius="48"
                    Background="#F6F7F9"
                    Margin="0,0,0,8">

                <PathIcon Data="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3M17,18L12,15.82L7,18V5H17V18Z"
                          Width="38"
                          Height="38"
                          Foreground="#9CA3AF"/>
            </Border>

            <TextBlock Text="No saved posts yet"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <TextBlock Text="Posts you save will appear here"
                       FontSize="14"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>

