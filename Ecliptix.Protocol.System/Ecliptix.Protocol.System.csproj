<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <!-- NuGet package provides native libraries and P/Invoke interop -->
      <PackageReference Include="Ecliptix.Protocol.Client" Version="1.0.0-ci.29" />
      <PackageReference Include="Google.Protobuf" Version="3.33.0" />
      <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
      <PackageReference Include="Grpc.Tools" Version="2.76.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Sodium.Core" Version="1.4.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Ecliptix.Protobufs\Ecliptix.Protobufs.csproj" />
      <ProjectReference Include="..\Ecliptix.Utilities\Ecliptix.Utilities.csproj" />
    </ItemGroup>

    <PropertyGroup>
      <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <!-- Keep only native interop/wrapper sources; managed protocol dirs have been removed -->
    <ItemGroup>
      <Compile Include="Native\**\*.cs" />
      <Compile Include="Sodium\**\*.cs" />
      <Compile Include="Utilities\**\*.cs" />
      <Compile Include="Configuration\**\*.cs" />
      <Compile Include="Interfaces\**\*.cs" />
      <Compile Include="Enums\**\*.cs" />
      <Compile Include="ProtocolSystemConstants.cs" />
      <Compile Include="AssemblyInfo.cs" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Scripts\**\*" />
    </ItemGroup>

</Project>
