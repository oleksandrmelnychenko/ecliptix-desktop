<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Feature.Feed.Feed.ViewModels"
             xmlns:postHeader="clr-namespace:Ecliptix.Feature.Feed.Feed.Controls.PostHeader"
             xmlns:media="clr-namespace:Ecliptix.Feature.Feed.Feed.Controls.Media"
             xmlns:postInteractions="clr-namespace:Ecliptix.Feature.Feed.Feed.Controls.PostInteractions"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="800"
             x:Class="Ecliptix.Feature.Feed.Feed.Controls.FeedItem.VideoPostControl"
             x:DataType="vm:VideoPostViewModel">

    <Border Background="#FFFFFF"
            CornerRadius="12"
            Margin="0,0,0,20"
            BoxShadow="0 1 3 0 #10000000"
            BorderBrush="#F3F4F6"
            BorderThickness="1"
            ClipToBounds="True">

        <StackPanel Spacing="0">

            <postHeader:PostHeaderControl DataContext="{Binding}" />

            <media:VideoPlayerControl />

            <postInteractions:PostActionsControl DataContext="{Binding Interactions}" />

        </StackPanel>

    </Border>

</UserControl>
