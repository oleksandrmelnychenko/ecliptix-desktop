<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Feature.NewContent.NewContent.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:NewPostViewModel"
             Width="510"
             Height="600"
             x:Class="Ecliptix.Feature.NewContent.NewContent.Views.NewPostView">
   <UserControl.Styles>
        <Style Selector="TextBox.input-box">
            <Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.input-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#6B5ECD"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Create Post"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#242424"/>
                <TextBlock Text="Share a photo or video with your followers"
                           FontSize="13"
                           Foreground="#757575"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    Padding="8"
                    CornerRadius="50"
                    Cursor="Hand"
                    VerticalAlignment="Top">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="12" Height="12" Foreground="#757575"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="20">

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#6B5ECD">
                        <TextBlock Text="ME"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Your Name" FontWeight="SemiBold" Foreground="#242424"/>
                        <TextBlock Text="@username" FontSize="12" Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>

                <Button Command="{Binding AddMediaCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch">

                    <Panel Height="200">

                        <Rectangle Stroke="#D0D0D0"
                                   StrokeThickness="2"
                                   StrokeDashArray="6,4"
                                   RadiusX="16" RadiusY="16"
                                   Fill="#FAFAFA"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <Border Background="#F0F0F0" CornerRadius="50" Width="48" Height="48">
                                <PathIcon Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                                          Width="20" Height="20" Foreground="#9E9E9E"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="Add photos or videos" FontWeight="Medium" Foreground="#242424" HorizontalAlignment="Center"/>
                                <TextBlock Text="or drag and drop" FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </Button>

                <StackPanel Spacing="4">
                    <TextBox Classes="input-box"
                             Text="{Binding Caption}"
                             Watermark="Write a caption..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             VerticalContentAlignment="Top"/>

                    <Grid ColumnDefinitions="Auto, *">
                        <PathIcon Grid.Column="0"
                                  Data="M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M15.5,8A1.5,1.5 0 0,0 14,9.5A1.5,1.5 0 0,0 15.5,11A1.5,1.5 0 0,0 17,9.5A1.5,1.5 0 0,0 15.5,8M8.5,8A1.5,1.5 0 0,0 7,9.5A1.5,1.5 0 0,0 8.5,11A1.5,1.5 0 0,0 10,9.5A1.5,1.5 0 0,0 8.5,8M12,17.5C14.33,17.5 16.31,16.04 17.11,14H6.89C7.69,16.04 9.67,17.5 12,17.5Z"
                                  Width="20" Height="20"
                                  Foreground="#9E9E9E"
                                  Margin="4,0,0,0"/>

                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Foreground="#9E9E9E"
                                   FontSize="12">
                            <Run Text="{Binding CaptionLength, Mode=OneWay}"/>
                            <Run Text=" / 2,200"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <TextBox Classes="input-box"
                         Watermark="Add location"
                         Text="{Binding Location}">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z"
                                  Width="16" Height="16"
                                  Foreground="#9E9E9E"
                                  Margin="12,0,4,0"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <StackPanel Spacing="0">
                    <Border BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="12,12,0,0" Padding="16,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Advanced settings" Foreground="#242424" VerticalAlignment="Center"/>
                            <TextBlock Text="Off" Foreground="#757575" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#E8E8E8" BorderThickness="1,0,1,1" Padding="16,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Hide like and view counts" Foreground="#242424" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideLikeViewCounts}"/>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#E8E8E8" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12" Padding="16,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Turn off commenting" Foreground="#242424" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding TurnOffCommenting}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Panel Height="20"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="0,16,0,0"
                BorderBrush="#F0F0F0"
                BorderThickness="0,1,0,0">
            <Button Command="{Binding ShareCommand}"
                    Content="Share"
                    HorizontalAlignment="Left"
                    Background="#B3A8E8"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="24,10"
                    CornerRadius="8">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#9D8ED6"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Border>

    </Grid>
</UserControl>

