<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsNotAsErrors>IDE0055;IDE0011;CA1308;IDE0060</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ecliptix.Core.Messaging\Ecliptix.Core.Messaging.csproj" />
    <ProjectReference Include="..\Ecliptix.Protocol.System\Ecliptix.Protocol.System.csproj" />
    <ProjectReference Include="..\Ecliptix.Security.Certificate.Pinning\Ecliptix.Security.Certificate.Pinning.csproj" />
    <ProjectReference Include="..\Ecliptix.Protobufs\Ecliptix.Protobufs.csproj" />
    <ProjectReference Include="..\Ecliptix.Utilities\Ecliptix.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Polly" Version="8.6.4" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="System.Interactive.Async" Version="6.0.3" />
    <PackageReference Include="System.Linq.Async" Version="6.0.3" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Infrastructure\Network\**\*.cs"
             Link="Infrastructure\Network\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Services\Network\**\*.cs"
             Link="Services\Network\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Services\Abstractions\Network\**\*.cs"
             Link="Services\Abstractions\Network\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Services\Abstractions\Authentication\IIdentityService.cs"
             Link="Services\Abstractions\Authentication\IIdentityService.cs" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Services\Common\**\*.cs"
             Link="Services\Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Services\External\IpGeolocation\IpCountry.cs"
             Link="Services\External\IpGeolocation\IpCountry.cs" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Infrastructure\Security\**\*.cs"
             Link="Infrastructure\Security\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Infrastructure\Data\Abstractions\IApplicationSecureStorageProvider.cs"
             Link="Infrastructure\Data\Abstractions\IApplicationSecureStorageProvider.cs" />
    <Compile Include="..\Ecliptix.Core\Ecliptix.Core\Infrastructure\Data\PendingLogoutRequestStorage.cs"
             Link="Infrastructure\Data\PendingLogoutRequestStorage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\Ecliptix.Core\Ecliptix.Core\Infrastructure\Network\Transport\Grpc\GrpcClientServiceExtensions.cs" />
  </ItemGroup>
</Project>
