        M14,5.546C13.816,5.654 13.635,5.774 13.458,5.907L12,7L10.542,5.907C7.404,3.553 2.881,5.105 1.848,8.889C1.324,10.813 1.87,12.87 3.28,14.28L6.5,17.5L10.586,21.586L12,23L13.414,21.586L17.5,17.5L20.72,14.28C21.368,13.632 21.834,12.846 22.097,12H19.942C19.778,12.315 19.564,12.607 19.306,12.866L16.086,16.086L12,20.172L7.914,16.086L4.694,12.866C3.792,11.963 3.442,10.647 3.778,9.416C4.439,6.993 7.333,6 9.342,7.507L10.8,8.6L12,9.5L13.2,8.6L14,8V5.546Z M16,7.089V5.055C18.643,4.678 21.378,6.261 22.152,9.098C22.252,9.465 22.313,9.837 22.336,10.208H20.33C20.311,10.013 20.275,9.817 20.222,9.624C19.699,7.706 17.775,6.684 16,7.089Z
    </StreamGeometry>

