<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PRECOMPILED ICON GEOMETRIES -->
    <!-- Parsed once at build time, shared across all post instances -->
    <!-- Significant performance improvement: no runtime SVG parsing -->

    <!-- Like/Heart Icon - Outline (Android Material Design - Unliked State) -->
    <!-- Clean outline without filled background -->
