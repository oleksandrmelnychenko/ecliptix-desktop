    <StreamGeometry x:Key="LikeIconFilledGeometry">
        M11.4,6.8L12,7.25L12.6,6.8L14.058,5.707C16.631,3.776 20.34,5.049 21.187,8.153C21.617,9.73 21.169,11.417 20.013,12.573L16.793,15.793L12,20.586L7.207,15.793L3.987,12.573C2.831,11.417 2.383,9.73 2.813,8.153C3.66,5.049 7.369,3.776 9.942,5.707L11.4,6.8Z
    </StreamGeometry>

    <!-- Comment/Chat Icon -->
    <StreamGeometry x:Key="CommentIconGeometry">
        M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z
