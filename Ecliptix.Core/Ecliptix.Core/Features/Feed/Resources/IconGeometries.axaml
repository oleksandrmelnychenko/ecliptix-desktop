    <!-- Save/Bookmark Icon -->
    <StreamGeometry x:Key="SaveIconGeometry">
        M17 3H7c-1.1 0-1.99.9-1.99 2L5 21l7-3 7 3V5c0-1.1-.9-2-2-2z
    </StreamGeometry>

    <!-- Play Icon (for video player) -->
    <StreamGeometry x:Key="PlayIconGeometry">
        M8 5v14l11-7z
    </StreamGeometry>

    <!-- Pause Icon (for video player) -->
    <StreamGeometry x:Key="PauseIconGeometry">
        M6 4h4v16H6V4zm8 0h4v16h-4V4z
    </StreamGeometry>

    <!-- Verification Badge Icon -->
    <StreamGeometry x:Key="VerifiedIconGeometry">
        M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z
    </StreamGeometry>

    <!-- Menu/Options Icon (3 dots) -->
    <StreamGeometry x:Key="MenuIconGeometry">
