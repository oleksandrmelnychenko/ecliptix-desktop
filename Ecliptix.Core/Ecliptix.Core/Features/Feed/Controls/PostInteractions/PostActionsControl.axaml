	Height="24"
	Stroke="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource LikeColorConverter}}"
	StrokeThickness="1.5"
	Fill="Transparent"
	Stretch="Uniform"
	Data="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource LikeIconConverter}}" />
	</Button>
	<TextBlock Text="{Binding Interaction.LikesCount}"
	HorizontalAlignment="Center"
	FontSize="14"
	LineHeight="20"
	Foreground="#0f172b" />
	</StackPanel>

	--><!-- Comment Button --><!--
	<StackPanel	Grid.Column="1"	HorizontalAlignment="Left" Spacing="6">
	<Button
	Background="Transparent"
	BorderThickness="0"
	Padding="1"
	Command="{Binding ToggleCommentsCommand}">
