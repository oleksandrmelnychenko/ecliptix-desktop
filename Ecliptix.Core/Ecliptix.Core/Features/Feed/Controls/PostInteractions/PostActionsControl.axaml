<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="60"
             x:Class="Ecliptix.Core.Features.Feed.Controls.PostInteractions.PostActionsControl"
             x:DataType="vm:PostInteractionsViewModel">

    <Border Padding="16,8">
        <Grid ColumnDefinitions="*,*,*,*">

            <!-- Like Button -->
            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Command="{Binding ToggleLikeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="24"
                          Height="24"
                          Fill="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource LikeColorConverter}}"
                          Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                    <TextBlock Text="Like"
                               FontSize="14"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Comment Button -->
            <Button Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="24"
                          Height="24"
                          Fill="#6B7280"
                          Data="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z" />
                    <TextBlock Text="Comment"
                               FontSize="14"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Share Button -->
            <Button Grid.Column="2"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Command="{Binding ShareCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="24"
                          Height="24"
                          Fill="#6B7280"
                          Data="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" />
                    <TextBlock Text="Share"
                               FontSize="14"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Save Button -->
            <Button Grid.Column="3"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Command="{Binding ToggleSaveCommand}">
                <Path Width="24"
                      Height="24"
                      Fill="{Binding Interaction.IsSavedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
                      Data="M17 3H7c-1.1 0-1.99.9-1.99 2L5 21l7-3 7 3V5c0-1.1-.9-2-2-2z" />
            </Button>

        </Grid>
    </Border>

</UserControl>
