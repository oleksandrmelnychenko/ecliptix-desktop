<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="40"
             x:Class="Ecliptix.Core.Features.Feed.Controls.PostInteractions.PostActionsControl"
             x:DataType="vm:PostInteractionsViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Features/Feed/Resources/IconGeometries.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,*,*,*"
          MaxWidth="425">

        <!-- Like Button -->
        <Button Grid.Column="0"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Command="{Binding ToggleLikeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="18"
                      Height="18"
                      Stroke="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource LikeColorConverter}}"
                      StrokeThickness="2"
                      Fill="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
                      Stretch="Uniform"
                      Data="{StaticResource LikeIconGeometry}" />
                <TextBlock Text="{Binding Interaction.LikesCount}"
                           FontSize="13"
                           Foreground="#536471"
                           IsVisible="{Binding Interaction.LikesCount, Converter={StaticResource GreaterThanZeroConverter}}" />
            </StackPanel>
        </Button>

        <!-- Comment Button -->
        <Button Grid.Column="1"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="18"
                      Height="18"
                      Stroke="#536471"
                      StrokeThickness="2"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Data="{StaticResource CommentIconGeometry}" />
                <TextBlock Text="{Binding Interaction.CommentsCount}"
                           FontSize="13"
                           Foreground="#536471"
                           IsVisible="{Binding Interaction.CommentsCount, Converter={StaticResource GreaterThanZeroConverter}}" />
            </StackPanel>
        </Button>

        <!-- Analytics Button -->
        <Button Grid.Column="2"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Width="18"
                      Height="18"
                      Fill="#536471"
                      Stretch="Uniform"
                      Data="{StaticResource AnalyticsIconGeometry}" />
                <TextBlock Text="0"
                           FontSize="13"
                           Foreground="#536471"
                           IsVisible="False" />
            </StackPanel>
        </Button>

        <!-- Bookmark Button -->
        <Button Grid.Column="3"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Command="{Binding ToggleSaveCommand}">
            <Path Width="18"
                  Height="18"
                  Fill="{Binding Interaction.IsSavedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
                  Stretch="Uniform"
                  Data="{StaticResource SaveIconGeometry}" />
        </Button>

    </Grid>

</UserControl>
