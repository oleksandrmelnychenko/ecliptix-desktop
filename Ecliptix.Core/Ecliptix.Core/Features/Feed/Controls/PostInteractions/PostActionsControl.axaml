<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="60"
			 x:Class="Ecliptix.Core.Features.Feed.Controls.PostInteractions.PostActionsControl"
			 x:DataType="vm:PostInteractionsViewModel">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Features/Feed/Resources/IconGeometries.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Border Padding="16,12">
		<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="20">

			<!-- Like Button -->
			<Button Grid.Column="0"
					HorizontalAlignment="Stretch"
					Background="Transparent"
					BorderThickness="0"
					Padding="1"
					Command="{Binding ToggleLikeCommand}">
				<StackPanel Spacing="8" HorizontalAlignment="Center">
					<Path Width="24"
						  Height="24"
						  Stroke="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource LikeColorConverter}}"
						  StrokeThickness="2"
						  Fill="{Binding Interaction.IsLikedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
						  Stretch="Uniform"
						  Data="{StaticResource LikeIconGeometry}" />
					<TextBlock Text="{Binding Interaction.LikesCount}"
							   FontSize="14"
							   LineHeight="20"
							   Foreground="#0f172b"
							   IsVisible="{Binding Interaction.LikesCount, Converter={StaticResource GreaterThanZeroConverter}}" />
				</StackPanel>
			</Button>

			<!-- Comment Button -->
			<Button Grid.Column="1"
					HorizontalAlignment="Stretch"
					Background="Transparent"
					BorderThickness="0"
					Padding="1"
					Command="{Binding ToggleCommentsCommand}">
				<StackPanel Spacing="8" HorizontalAlignment="Center">
					<Path Width="24"
						  Height="24"
						  Stroke="#536471"
						  StrokeThickness="2"
						  Fill="Transparent"
						  Stretch="Uniform"
						  Data="{StaticResource CommentIconGeometry}" />
					<TextBlock Text="{Binding Interaction.CommentsCount}"
							   FontSize="14"
							   LineHeight="20"
							   Foreground="#0f172b"
							   IsVisible="{Binding Interaction.CommentsCount, Converter={StaticResource GreaterThanZeroConverter}}" />
				</StackPanel>
			</Button>

			<!-- Analytics Button -->
			<Button Grid.Column="3"
					HorizontalAlignment="Stretch"
					Background="Transparent"
					BorderThickness="0"
					Padding="1">
				<StackPanel Spacing="8" HorizontalAlignment="Center">
					<Path Width="24"
						  Height="24"
						  Fill="#536471"
						  Stretch="Uniform"
						  Data="{StaticResource AnalyticsIconGeometry}" />
					<TextBlock Text="0"
							   FontSize="14"
							   LineHeight="20"
							   Foreground="#0f172b"
							   IsVisible="False" />
				</StackPanel>
			</Button>

			<!-- Bookmark Button -->
			<Button Grid.Column="4"
					HorizontalAlignment="Stretch"
					Background="Transparent"
					BorderThickness="0"
					Padding="1"
					Command="{Binding ToggleSaveCommand}">
				<Path Width="24"
					  Height="24"
					  Fill="{Binding Interaction.IsSavedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
					  Stretch="Uniform"
					  Data="{StaticResource SaveIconGeometry}" />
			</Button>

		</Grid>
	</Border>

	<!--<Border Padding="16,12">
	<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="20">

