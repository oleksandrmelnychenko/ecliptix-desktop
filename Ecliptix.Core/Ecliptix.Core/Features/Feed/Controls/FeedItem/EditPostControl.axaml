<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="400"
			 xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
			 xmlns:feedItem="clr-namespace:Ecliptix.Core.Features.Feed.Controls.FeedItem"
			 xmlns:commentItem="clr-namespace:Ecliptix.Core.Features.Feed.Controls.Comments"
			 x:Class="Ecliptix.Core.Features.Feed.Controls.FeedItem.EditPostControl"
			 x:DataType="vm:TextPostViewModel">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Features/Feed/Resources/IconGeometries.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid Background="#FFFFFF">
		<Border MaxWidth="1020"
				HorizontalAlignment="Stretch"
				Padding="40,0">
			<Grid RowDefinitions="Auto,*">
				<feedItem:TextPostControl />

				<commentItem:CommentItemControl Grid.Row="1" DataContext="{Binding Comments}"/>
			</Grid>
		</Border>

		<!--Back button-->
		<Button	Margin="10,10,0,0"
				CornerRadius="20"
				Width="32"
				Height="32"
				Padding="0"
				Background="LightGray"
				HorizontalAlignment="Left"
				BorderThickness="0"
				VerticalAlignment="Top"
				Command="{Binding BackCommand}">
			<Path Width="35"
				  Height="4"
				  Fill="#6a5acd"
				  Data="{StaticResource MenuIconGeometry}">
				<Path.RenderTransform>
					<TransformGroup>
						<RotateTransform Angle="90" CenterX="2" CenterY="8"/>
					</TransformGroup>
				</Path.RenderTransform>
			</Path>
		</Button>

		<!-- Entry -->
		<Border  VerticalAlignment="Bottom"
				 HorizontalAlignment="Center"
				 Margin="0,0,0,20"
				 Background="#F9FAFB"
				 CornerRadius="12"
				 Padding="4">
			<TextBox Background="Transparent"
					 BorderThickness="0"
					 VerticalAlignment="Center"
					 Watermark="Add a comment..."
					 FontSize="14"
					 Margin="0" />
		</Border>
	</Grid>
</UserControl>
