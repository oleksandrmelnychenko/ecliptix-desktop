<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="400"
			 xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
			 xmlns:feedItem="clr-namespace:Ecliptix.Core.Features.Feed.Controls.FeedItem"
			 xmlns:commentItem="clr-namespace:Ecliptix.Core.Features.Feed.Controls.Comments"
			 x:Class="Ecliptix.Core.Features.Feed.Controls.FeedItem.EditPostControl"
			 x:DataType="vm:TextPostViewModel">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Features/Feed/Resources/IconGeometries.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid Background="#FFF">
		<Border MaxWidth="1020"
				HorizontalAlignment="Stretch"
				Padding="40,10">
			<Grid RowDefinitions="Auto,*">
				<feedItem:TextPostControl />

				<commentItem:CommentItemControl Grid.Row="1"
												Margin="16,0"
												DataContext="{Binding Comments}"/>
			</Grid>
		</Border>

		<!--Back button-->
		<Button	Margin="0,10,0,0"
				CornerRadius="20"
				Width="32"
				Height="32"
				Padding="0"
				Background="LightGray"
				HorizontalAlignment="Left"
				BorderThickness="0"
				VerticalAlignment="Top"
				Command="{Binding BackCommand}">
			<Path Width="35"
				  Height="4"
				  Fill="#6a5acd"
				  Data="{StaticResource MenuIconGeometry}">
				<Path.RenderTransform>
					<TransformGroup>
						<RotateTransform Angle="90" CenterX="2" CenterY="8"/>
					</TransformGroup>
				</Path.RenderTransform>
			</Path>
		</Button>

		<!-- Entry -->
		<Grid RowDefinitions="Auto,Auto"
			  RowSpacing="10"
			  VerticalAlignment="Bottom"
			  HorizontalAlignment="Stretch"
			  Margin="120,0,120,20">

			<Border Grid.Row="0"
					Height="38"
					CornerRadius="10"
					BorderThickness="1"					
					BorderBrush="#E5E7EB"
					IsVisible="{Binding Comments.HasReplyComment}"
					Background="#FFF"					
					BoxShadow="0 2 8 0 #15000000">

				<Grid ColumnDefinitions="Auto,Auto,*,Auto">

					<TextBlock Text="Replying to"
							   Margin="15,0,0,0"
							   FontSize="12"
							   Foreground="#6A7383"
							   VerticalAlignment="Center"/>

					<TextBlock Grid.Column="1"
							   Text="{Binding Comments.ReplyComment.Author.Username, StringFormat=' @{0}'}"
							   FontSize="12"
							   FontWeight="600"
							   Foreground="#6a5acd"
							   VerticalAlignment="Center"/>

					<Button Grid.Column="2"
							Margin="0,0,15,0"
							CornerRadius="2"
							Width="12"
							Height="12"
							Padding="0"
							Background="LightGray"
							HorizontalAlignment="Right"
							BorderThickness="0"
							VerticalAlignment="Center"
							Command="{Binding Comments.ClearReplyCommand}">
					</Button>
				</Grid>
			</Border>

			<commentItem:CommentInputControl Grid.Row="1" DataContext="{Binding Comments}" />
		</Grid>
	</Grid>
</UserControl>
