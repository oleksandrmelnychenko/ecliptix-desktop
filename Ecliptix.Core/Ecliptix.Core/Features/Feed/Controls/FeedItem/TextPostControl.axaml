<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
             xmlns:header="clr-namespace:Ecliptix.Core.Features.Feed.Controls.PostHeader"
             xmlns:interactions="clr-namespace:Ecliptix.Core.Features.Feed.Controls.PostInteractions"
             xmlns:comments="clr-namespace:Ecliptix.Core.Features.Feed.Controls.Comments"
             xmlns:converters="clr-namespace:Ecliptix.Core.Features.Feed.Converters"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="400"
             x:Class="Ecliptix.Core.Features.Feed.Controls.FeedItem.TextPostControl"
             x:DataType="vm:TextPostViewModel">

    <UserControl.Resources>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="0"
            Margin="0"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1"
            Padding="16"
            ClipToBounds="False">

        <!-- 2 Column Layout: Avatar | Content -->
        <Grid ColumnDefinitions="48,*">

            <!-- Left Column: Avatar -->
            <Border Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="24"
                    ClipToBounds="True"
                    Background="#F0F0F0"
                    VerticalAlignment="Top">
                <Panel>
                    <Image Source="{Binding Post.Author.AvatarUrl}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding Post.Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Post.Author.DisplayName, Converter={StaticResource InitialsConverter}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Post.Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
                </Panel>
            </Border>

            <!-- Right Column: Content -->
            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        Spacing="8">

                <!-- User Info Header -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Post.Author.DisplayName}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#1A1A1A" />
                        <Path Width="16"
                              Height="16"
                              Fill="#1DA1F2"
                              Data="{StaticResource VerifiedIconGeometry}"
                              IsVisible="{Binding Post.Author.IsVerified}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Post.Author.Username, StringFormat='@{0}'}"
                                   FontSize="13"
                                   Foreground="#6B7280" />
                        <TextBlock Text="·"
                                   FontSize="13"
                                   Foreground="#6B7280" />
                        <TextBlock Text="{Binding RelativeTime}"
                                   FontSize="13"
                                   Foreground="#6B7280" />
                    </StackPanel>
                </StackPanel>

                <!-- Text Content -->
                <TextBlock Text="{Binding TextContent.Text}"
                           TextWrapping="Wrap"
                           FontSize="15"
                           LineHeight="20"
                           Foreground="#0F1419" />

                <!-- Hashtags -->
                <ItemsControl ItemsSource="{Binding TextContent.Hashtags}"
                              IsVisible="{Binding TextContent.Hashtags, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='#{0} '}"
                                       Foreground="#1D9BF0"
                                       FontSize="14"
                                       Margin="0,0,6,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Action Icons at Bottom -->
                <interactions:PostActionsControl DataContext="{Binding Interactions}"
                                                 Margin="0,8,0,0" />

                <!-- Comments Section -->
                <Border IsVisible="{Binding ShowComments}"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="0">

                        <!-- Comment Input -->
                        <comments:CommentInputControl DataContext="{Binding Comments}" />

                        <!-- Comments List -->
                        <ItemsControl ItemsSource="{Binding Comments.Comments}"
                                      Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <comments:CommentItemControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Load More Comments -->
                        <Border Padding="0,8"
                                IsVisible="{Binding Comments.HasMoreComments}">
                            <Button Content="Load more comments"
                                    Command="{Binding Comments.LoadMoreCommentsCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#6B7280"
                                    FontSize="13"
                                    HorizontalAlignment="Left" />
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
