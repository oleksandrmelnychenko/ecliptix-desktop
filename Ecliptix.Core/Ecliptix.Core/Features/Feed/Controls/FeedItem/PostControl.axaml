<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
			 x:DataType="vm:PostControlViewModel"
			 mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="400"
			 x:Class="Ecliptix.Core.Features.Feed.Controls.FeedItem.PostControl">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Features/Feed/Resources/IconGeometries.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid RowDefinitions="auto,auto,auto,auto">
		<!-- Post Header -->
		<Border Grid.Row="0" Padding="16,12,16,6">
			<Grid ColumnDefinitions="Auto,*">

				<!-- Avatar -->
				<Border Grid.Column="0"
						Width="40"
						Height="40"
						CornerRadius="20"
						ClipToBounds="True"
						Background="#F0F0F0">
					<Panel>
						<Image Source="{Binding AvatarUrl}"
							   Stretch="UniformToFill"
							   IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
						<TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}"
								   FontSize="16"
								   FontWeight="SemiBold"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
					</Panel>
				</Border>

				<!-- User Info -->
				<StackPanel Grid.Column="1"
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Spacing="2">

					<TextBlock Text="{Binding DisplayName}"
							   FontSize="16"
							   LineHeight="24"
							   Foreground="#0f172b" />

					<TextBlock Text="{Binding Username, StringFormat='@{0}'}"
							   FontSize="14"
							   LineHeight="20"
							   Foreground="#62748e" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- Text Content -->
		<Border Grid.Row="1" Padding="16,0,16,12">
			<TextBlock Text="{Binding Text}"
					   TextWrapping="Wrap"
					   FontSize="16"
					   LineHeight="24"
					   Foreground="#314158" />
		</Border>

		<!-- Post Actions -->
		<Border Grid.Row="2" Padding="16,12">
			<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="20">
				<!-- Like Button -->
				<StackPanel Grid.Column="0"	HorizontalAlignment="Left" Spacing="6">
					<Button
					Background="Transparent"
					BorderThickness="0"
					Padding="1"
					Command="{Binding ToggleLikeCommand}">
						<Path Width="20"
							  Height="20"
							  Stroke="{Binding IsLikedByCurrentUser, Converter={StaticResource LikeColorConverter}}"
							  StrokeThickness="1.5"
							  Fill="Transparent"
							  Stretch="Uniform"
							  Data="{Binding IsLikedByCurrentUser, Converter={StaticResource LikeIconConverter}}" />
					</Button>
					<TextBlock Text="{Binding LikesCount}"
							   HorizontalAlignment="Center"
							   FontSize="14"
							   Foreground="#0f172b" />
				</StackPanel>

				<!-- Comment Button -->
				<StackPanel	Grid.Column="1"	HorizontalAlignment="Left" Spacing="6">
					<Button
					Background="Transparent"
					BorderThickness="0"
					Padding="1"
					Command="{Binding ToggleCommentsCommand}">
						<Path Width="20"
							  Height="20"
							  Stroke="#6B7280"
							  StrokeThickness="1.5"
							  Fill="Transparent"
							  Stretch="Uniform"
							  Data="{StaticResource CommentIconGeometry}" />
					</Button>
					<TextBlock Text="{Binding CommentsCount}"
							   HorizontalAlignment="Center"
							   FontSize="14"
							   Foreground="#0f172b" />
				</StackPanel>

				<!-- Unknown Button -->
				<Button Grid.Column="3"
						HorizontalAlignment="Right"
						Background="Transparent"
						BorderThickness="0"
						Padding="1"
						MinHeight="40"
						Command="{Binding ToggleSaveCommand}">
					<Path Width="20"
						  Height="20"
						  Fill="{Binding IsSavedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
						  Data="{StaticResource SaveIconGeometry}" />
				</Button>

				<!-- Save Button -->
				<Button Grid.Column="4"
						HorizontalAlignment="Right"
						Background="Transparent"
						BorderThickness="0"
						Padding="1"
						MinHeight="40"
						Command="{Binding ToggleSaveCommand}">
					<Path Width="20"
						  Height="20"
						  Fill="{Binding IsSavedByCurrentUser, Converter={StaticResource SaveColorConverter}}"
						  Data="{StaticResource SaveIconGeometry}" />
				</Button>

				<!--Relative time-->
				<TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5"
						   Margin="0,12"
						   Text="{Binding RelativeTime}"
						   HorizontalAlignment="Left"
						   FontSize="12"
						   LineHeight="16"
						   Foreground="#0f172b" />

				<!--Comments control-->
				<Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
					  IsVisible="{Binding ShowComments}"
					  RowDefinitions="1,Auto,Auto,Auto,Auto"					  >

					<!--Top line-->
					<Border Grid.Row="0"
							Background="#F3F4F6"
							Height="0.5"
							HorizontalAlignment="Stretch"/>

					<Button Grid.Row="1"
							Content="{Binding CommentsCount, StringFormat='View all {0} comments'}"
							IsVisible="{Binding IsVisibleShowAllComments}"
							Background="Transparent"
							Padding="0"
							BorderThickness="0"
							Foreground="#6a7282"
							FontSize="14"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Command="{Binding ToggleFullVisibilityCommentsCommand}"
							Margin="0,12,0,0" />

					<!--Comments-->
					<ItemsControl Grid.Row="2" ItemsSource="{Binding Comments}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,12" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
									<Border Grid.Column="0" Grid.RowSpan="2"
											Width="40"
											Height="40"
											CornerRadius="20"
											ClipToBounds="True"
											Background="#F0F0F0">
										<Panel>
											<Image
											Source="{Binding Author.AvatarUrl}"
											Stretch="UniformToFill"
											IsVisible="{Binding Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
											<TextBlock Grid.Column="1"
													   Text="{Binding Author.DisplayName, Converter={StaticResource InitialsConverter}}"
													   FontSize="16"
													   FontWeight="SemiBold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"
													   IsVisible="{Binding Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
										</Panel>
									</Border>

									<TextBlock
										Grid.Column="1"
										Text="{Binding Author.DisplayName}"
										FontWeight="SemiBold"
										Foreground="#0f172b"
										FontSize="14"/>

									<TextBlock
										Grid.Column="2"
										Text="{Binding Text}"
										Foreground="#314158"
										FontSize="14"/>

									<Border Grid.Column="3"
											Width="10"
											Height="10"
											VerticalAlignment="Top"
											CornerRadius="3"
											ClipToBounds="True"
											Background="Red"/>

									<StackPanel Spacing="10"
												Orientation="Horizontal"
												Grid.Row="1"
												Grid.Column="1"
												Grid.ColumnSpan="3">
										<TextBlock
											Text="{Binding CreatedAt, StringFormat=' {0:mm} ago'}"
											Foreground="#99A1AF"
											FontSize="12"/>

										<TextBlock
											Text="{Binding LikesCount, StringFormat=' {0} likes'}"
											Foreground="#314158"
											FontSize="12"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button Grid.Row="3"
							Content="Show less"
							IsVisible="{Binding ShowAllComments}"
							Background="Transparent"
							Padding="0"
							BorderThickness="0"
							Foreground="#6a7282"
							FontSize="14"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Command="{Binding ToggleFullVisibilityCommentsCommand}"
							Margin="0,0,0,12" />

					<Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="15">

						<!-- Avatar -->
						<Border Grid.Column="0"
								Width="40"
								Height="40"
								CornerRadius="20"
								ClipToBounds="True"
								Background="#8a7ae0">
							<Panel>
								<Image Source="{Binding AvatarUrl}"
									   Stretch="UniformToFill"
									   IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
								<TextBlock Text="ME"
										   FontSize="16"
										   Foreground="#fff"
										   FontWeight="SemiBold"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"
										   IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
							</Panel>
						</Border>

						<!-- Entry -->
						<Border  Grid.Column="2"
								 Background="#F9FAFB"
								 CornerRadius="12"
								 Padding="4">
							<TextBox
							Background="Transparent"
							BorderThickness="0"
							VerticalAlignment="Center"
							Watermark="Add a comment..."
							FontSize="14"
							Margin="0" />
						</Border>
					</Grid>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
