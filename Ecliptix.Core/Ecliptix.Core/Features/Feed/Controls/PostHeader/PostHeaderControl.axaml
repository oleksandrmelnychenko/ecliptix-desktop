<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Ecliptix.Core.Features.Feed.Models"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="60"
             x:Class="Ecliptix.Core.Features.Feed.Controls.PostHeader.PostHeaderControl"
             x:DataType="models:PostAuthor">

    <Border Padding="16,12">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Avatar -->
            <Border Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    ClipToBounds="True"
                    Background="#F0F0F0">
                <Panel>
                    <Image Source="{Binding AvatarUrl}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
                </Panel>
            </Border>

            <!-- User Info -->
            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A" />
                    <Path Width="16"
                          Height="16"
                          Fill="#1DA1F2"
                          Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                          IsVisible="{Binding IsVerified}" />
                </StackPanel>
                <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                           FontSize="12"
                           Foreground="#6B7280" />
            </StackPanel>

            <!-- Menu Button -->
            <Button Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center">
                <Path Width="4"
                      Height="16"
                      Fill="#6B7280"
                      Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
            </Button>

        </Grid>
    </Border>

</UserControl>
