<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="60"
			 xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
			 x:Class="Ecliptix.Core.Features.Feed.Controls.PostHeader.PostHeaderControl"
			 x:DataType="vm:FeedItemViewModel">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Features/Feed/Resources/IconGeometries.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Border Padding="16,12">
		<Grid ColumnDefinitions="Auto,*,Auto">

			<!-- Avatar -->
			<Border Grid.Column="0"
					Width="32"
					Height="32"
					CornerRadius="20"
					ClipToBounds="True"
					Background="#F0F0F0">
				<Panel>
					<Image asyncImageLoader:ImageLoader.Source="{Binding Post.Author.AvatarUrl}"
						   Stretch="UniformToFill"
						   IsVisible="{Binding Post.Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
					<TextBlock Text="{Binding Post.Author.DisplayName, Converter={StaticResource InitialsConverter}}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   IsVisible="{Binding Post.Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
				</Panel>
			</Border>

			<!-- User Info -->
			<StackPanel Grid.Column="1"
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Spacing="2">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock Text="{Binding Post.Author.DisplayName}"
							   FontSize="16"
							   FontWeight="Medium"							  
							   Foreground="#0f172b" />
					<Ellipse Width="16"
							 Height="16"
							 Fill="#6a5acd"
							 IsVisible="{Binding Post.Author.IsVerified}" />
					<TextBlock Text="{Binding RelativeTime, StringFormat='· {0}'}"
							   FontSize="14"
							   LineHeight="20"
							   Foreground="#62748e" />
				</StackPanel>
				<TextBlock Text="{Binding Post.Author.Username, StringFormat='@{0}'}"
						   FontSize="14"
						   LineHeight="20"
						   Foreground="#62748e" />
			</StackPanel>

			<!-- Menu Button -->
			<Button Grid.Column="2"
					CornerRadius="20"
					Width="36"
					Height="36"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					VerticalAlignment="Center">
				<Path Width="35"
					  Height="4"
					  Fill="#6a5acd"					  
					  Data="{StaticResource MenuIconGeometry}">
					<Path.RenderTransform>
						<TransformGroup>
							<RotateTransform Angle="90" CenterX="2" CenterY="8"/>
					</TransformGroup>
					</Path.RenderTransform>
				</Path>
			</Button>
		</Grid>
	</Border>
</UserControl>
