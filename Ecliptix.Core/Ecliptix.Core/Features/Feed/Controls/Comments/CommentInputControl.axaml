<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Feed.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="60"
             x:Class="Ecliptix.Core.Features.Feed.Controls.Comments.CommentInputControl"
             x:DataType="vm:CommentSectionViewModel">

    <Border Padding="16"
            BorderBrush="#E5E7EB"
            BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto">

            <!-- Input -->
            <TextBox Grid.Column="0"
                     Text="{Binding CommentText}"
                     Watermark="Add a comment..."
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     FontSize="14" />

            <!-- Post Button -->
            <Button Grid.Column="1"
                    Content="Post"
                    Command="{Binding PostCommentCommand}"
                    IsEnabled="{Binding CommentText, Converter={StaticResource NotNullOrEmptyConverter}}"
                    Background="#3B82F6"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    CornerRadius="4"
                    Padding="16,6"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="8,0,0,0" />

        </Grid>
    </Border>

</UserControl>
