<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Core.Features.Settings.ViewModels"
             xmlns:hintedTextControls="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             x:DataType="viewModels:AccountSettingsViewModel"
             x:Class="Ecliptix.Core.Features.Settings.Views.AccountSettingsView">

    <UserControl.Resources>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.setting-row">
            <Setter Property="BorderBrush" Value="#F0F0F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
            </Style>

        <Style Selector="TextBox.setting-input">
            <Setter Property="Width" Value="175" /> <Setter Property="HorizontalAlignment" Value="Right" /> <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button.avatar-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="50" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.avatar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
             <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.avatar-overlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="#80000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.avatar-button:pointerover Border.avatar-overlay">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="Border.success-toast">
            <Setter Property="Background" Value="#E6F4EA" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.success-toast.visible">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel>
            <StackPanel Margin="0,0,0,30" HorizontalAlignment="Center">
                <Button Classes="avatar-button"
                        Command="{Binding ChangeAvatarCommand}"
                        Width="96" Height="96">
                    <Panel>
                        <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True"
                                Background="#FFF0E0" BorderBrush="#FF6D00" BorderThickness="2">
                            <TextBlock Text="{Binding ProfileInitials}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontWeight="Bold" FontSize="32"
                                       Foreground="#FF6D00"/>
                        </Border>
                        </Panel>
                </Button>
            </StackPanel>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="Display Name" Classes="setting-label"/>

                    <hintedTextControls:HintedTextBox Grid.Column="1"
                                        Text="{Binding DisplayName}"
                                        Watermark="Enter display name"
                                        Hint="Visible to other users"
                                        HorizontalAlignment="Right"
                                        Width="260"
                                        Height="56"
                                        TextForeground="#242424"
                                        HintForeground="#888888"
                                        MainBorderBrush="Transparent"
                                        Background="#fff8f8f8"
                                        CornerRadius="8"
                                        FontSize="14"
                                        WatermarkFontSize="14"
                                        FontWeight="Normal"
                                        HasError="False"
                                        ErrorText="Name is too short"
                                        />
                </Grid>
            </Border>


            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="Profile Name" Classes="setting-label"/>
                    <hintedTextControls:HintedTextBox Grid.Column="1"
                                        Text="{Binding ProfileName}"
                                        Hint="Unique profile identifier"

                                        HorizontalAlignment="Right"
                                        Width="260"
                                        Height="56"

                                        TextForeground="#555555"
                                        HintForeground="#888888"
                                        MainBorderBrush="Transparent"
                                        Background="#F5F5F5"
                                        CornerRadius="8"
                                        FontSize="14"
                                        IsEnabled="False"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Height="32">
                <Border Classes="success-toast" Classes.visible="{Binding IsSavedMessageVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                  Width="14" Height="14" Foreground="#1E8E3E"/>
                        <TextBlock Text="Settings saved" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Medium" Foreground="#1E8E3E"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
