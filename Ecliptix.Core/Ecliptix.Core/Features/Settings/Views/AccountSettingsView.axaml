<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Core.Features.Settings.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:AccountSettingsViewModel"
             x:Class="Ecliptix.Core.Features.Settings.Views.AccountSettingsView">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SidebarBackground" Color="#FEFEFE" />
        <SolidColorBrush x:Key="Primary" Color="#FF6D00"/>
        <SolidColorBrush x:Key="OnSurface" Color="#242424"/>
        <SolidColorBrush x:Key="SurfaceVariant" Color="#F2F6F7"/>

        <BoxShadows x:Key="DefaultShadow">0 1 3 0 #20000000</BoxShadows>
        <BoxShadows x:Key="FocusShadow">0 0 0 2 #40FF6D00</BoxShadows>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.modern-input-wrapper">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BoxShadow" Value="{StaticResource DefaultShadow}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.modern-input-wrapper:pointerover">
            <Setter Property="BorderBrush" Value="#C0C0C0" />
        </Style>
        <Style Selector="Border.modern-input-wrapper:focus-within">
            <Setter Property="BorderBrush" Value="#FF6D00" />
            <Setter Property="BoxShadow" Value="{StaticResource FocusShadow}" />
        </Style>
        <Style Selector="Border.modern-input-wrapper > TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="Border.modern-input-wrapper TextBox:disabled">
             <Setter Property="Foreground" Value="#888888"/>
        </Style>

        <Style Selector="Button.accent-button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accent-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF6B35" Offset="0.0"/>
                    <GradientStop Color="#F7931E" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3" Easing="CubicEaseInOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF8C52" Offset="0.0"/>
                    <GradientStop Color="#FFB84D" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.accent-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#CC5529" Offset="0.0"/>
                    <GradientStop Color="#E07A1A" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="40,30">
        <Grid ColumnDefinitions="*, 175"
              RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
              MaxWidth="800">

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Account Settings" Classes="section-title" Margin="0,0,0,25"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile Icon" Classes="form-label"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
                <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True"
                        Background="#FFF0E0" BorderBrush="#FF6D00" BorderThickness="2">
                    <Panel>
                        <TextBlock Text="{Binding ProfileInitials}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontWeight="Bold" FontSize="18" Foreground="#FF6D00"/>
                    </Panel>
                </Border>
                <Button Content="Change" Background="Transparent" BorderBrush="#D0D0D0" BorderThickness="1"
                        CornerRadius="6" Padding="12,6" Foreground="#555"/>
            </StackPanel>

            <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#E0E0E0" Height="1" Opacity="0.5" Margin="0,20"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Display Name" Classes="form-label"/>
            <Border Grid.Row="3" Grid.Column="1" Classes="modern-input-wrapper">
                <TextBox Text="{Binding DisplayName}" Watermark="Enter display name"/>
            </Border>

            <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Background="#E0E0E0" Height="1" Opacity="0.5" Margin="0,20"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Profile Name" Classes="form-label"/>
            <Border Grid.Row="5" Grid.Column="1" Classes="modern-input-wrapper" Background="#FAFAFA">
                <TextBox Text="{Binding ProfileName}" IsReadOnly="True" Foreground="#777"/>
            </Border>

            <Separator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Background="#E0E0E0" Height="1" Opacity="0.5" Margin="0,20"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Account ID" Classes="form-label"/>
            <Border Grid.Row="7" Grid.Column="1" Classes="modern-input-wrapper" Background="#FAFAFA">
                <TextBox Text="{Binding AccountId}" IsReadOnly="True" FontFamily="Consolas, Monospace" Foreground="#777"/>
            </Border>

            <Separator Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Background="#E0E0E0" Height="1" Opacity="0.5" Margin="0,20"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Profile ID" Classes="form-label"/>
            <Border Grid.Row="9" Grid.Column="1" Classes="modern-input-wrapper" Background="#FAFAFA">
                <TextBox Text="{Binding ProfileId}" IsReadOnly="True" FontFamily="Consolas, Monospace" Foreground="#777"/>
            </Border>

            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Classes="accent-button" Command="{Binding SaveChangesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="16" Height="16" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

