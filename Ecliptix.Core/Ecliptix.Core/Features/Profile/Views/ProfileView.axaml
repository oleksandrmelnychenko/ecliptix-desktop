<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Profile.ViewModels"
             xmlns:views="clr-namespace:Ecliptix.Core.Features.Profile.Views"
             xmlns:page="clr-namespace:Ecliptix.Core.Shared.Transitions.Page"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ProfileViewModel"
             x:Class="Ecliptix.Core.Features.Profile.Views.ProfileView">

  <UserControl.Resources>
        <SolidColorBrush x:Key="NavBackground" Color="#FEFEFE" />
        <BoxShadows x:Key="FloatingShadow">0 4 20 0 #1A000000</BoxShadows>
        <SolidColorBrush x:Key="AccentDotColor" Color="#6C5CE7"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.nav-icon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.nav-icon-button:pointerover">
            <Setter Property="Background" Value="#F2F6F7" />
        </Style>

        <Style Selector="Button.nav-icon-button:pressed">
            <Setter Property="Background" Value="#E0E6E8" />
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>

        <Style Selector="Button.nav-icon-button.selected">
            <Setter Property="Background" Value="#F2F6F7" />
        </Style>

        <Style Selector="PathIcon.nav-icon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#5C5C5C" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.nav-icon-button.selected PathIcon.nav-icon">
            <Setter Property="Foreground" Value="#242424" />
        </Style>

        <Style Selector="Button.nav-icon-button:pointerover PathIcon.nav-icon">
            <Setter Property="Foreground" Value="#242424" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid HorizontalAlignment="Stretch">
            <TransitioningContentControl Content="{Binding CurrentProfilePage}"
                                         IsTransitionReversed="{Binding IsTransitionReversed}">

                <TransitioningContentControl.PageTransition>
                    <page:SharedAxisPageTransition Duration="0:0:0.400"
                                               SlideDistance="90"
                                               FadeThreshold="0.35"
                                               Orientation="Horizontal">
                        <page:SharedAxisPageTransition.Easing>
                            <SplineEasing X1="0.2" Y1="0.0" X2="0.0" Y2="1.0"/>
                        </page:SharedAxisPageTransition.Easing>
                    </page:SharedAxisPageTransition>
                </TransitioningContentControl.PageTransition>

                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:AboutProfileViewModel}">
                        <views:AboutProfileView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PersonalPostsProfileViewModel}">
                        <views:PersonalPostsProfileView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PersonalImagesProfileViewModel}">
                        <views:PersonalImagesProfileView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PersonalLikesProfileViewModel}">
                        <views:PersonalLikesProfileView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PersonalFavoritesViewModel}">
                        <views:PersonalFavoritesView/>
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>
        </Grid>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Background="{StaticResource NavBackground}"
                BorderBrush="#E8E8E8"
                BorderThickness="1"
                CornerRadius="100"
                Padding="12,6"
                BoxShadow="{StaticResource FloatingShadow}">
            <ItemsControl ItemsSource="{Binding MenuItems}"
                          ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileMenuItem">

                        <Panel Width="44" Height="44"
                               VerticalAlignment="Center"
                               ClipToBounds="False">

                            <Button Classes="nav-icon-button"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).NavigateCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Title}">
                                <PathIcon Classes="nav-icon" Data="{Binding IconData}" />
                            </Button>

                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource AccentDotColor}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsSelected}"
                                     Margin="0,0,-4,0"
                                     IsHitTestVisible="False"/>
                        </Panel>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>

