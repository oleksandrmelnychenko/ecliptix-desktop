<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:newContent="clr-namespace:Ecliptix.Core.Features.NewContent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="newContent:NewGroupChatViewModel"
             Width="510"
             Height="600"
             x:Class="Ecliptix.Core.Features.NewContent.NewGroupChatView">
    <UserControl.Styles>
        <Style Selector="TextBox.input-box">
            <Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.input-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#6B5ECD"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="New Group"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#242424"/>
                <TextBlock Text="Create a group chat to message multiple people at once"
                           FontSize="13"
                           Foreground="#757575"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    Padding="8"
                    CornerRadius="50"
                    Cursor="Hand"
                    VerticalAlignment="Top">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Width="12" Height="12" Foreground="#757575"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="24">

                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,0">
                    <Button Command="{Binding UploadPhotoCommand}"
                            Width="80" Height="80"
                            CornerRadius="40"
                            Background="#6B5ECD"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#5A4EB5"/>
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14M12,2A6,6 0 0,0 6,8A6,6 0 0,0 12,14A6,6 0 0,0 18,8A6,6 0 0,0 12,2M12,16C7.97,16 6,18 6,18V18H18V18C18,18 16.03,16 12,16Z"
                                  Width="32" Height="32"
                                  Foreground="White"/>
                    </Button>
                    <TextBlock Text="Add group photo"
                               FontSize="12"
                               Foreground="#757575"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Group Name"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#5C5C5C"/>
                    <TextBox Classes="input-box"
                             Watermark="Enter group name"
                             Text="{Binding GroupName}"/>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Add Members"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#5C5C5C"/>

                    <TextBox Classes="input-box"
                             Watermark="Search contacts..."
                             Text="{Binding SearchQuery}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Width="16" Height="16"
                                      Foreground="#9E9E9E"
                                      Margin="12,0,4,0"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <ItemsControl ItemsSource="{Binding Contacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="newContent:ContactItemViewModel">
                                <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,6">

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>

                                    <Panel Grid.Column="1" Width="40" Height="40" Margin="0,0,12,0">
                                        <Ellipse Width="40" Height="40">
                                            <Ellipse.Fill>
                                                <ImageBrush Source="{Binding AvatarPath}"
                                                            Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <Border Width="12" Height="12"
                                                CornerRadius="6"
                                                Background="#00C853"
                                                BorderBrush="White"
                                                BorderThickness="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                IsVisible="{Binding IsOnline}"/>
                                    </Panel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Medium"
                                                   Foreground="#242424"
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding Handle}"
                                                   Foreground="#757575"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <Panel Height="20"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="0,16,0,0"
                BorderBrush="#F0F0F0"
                BorderThickness="0,1,0,0">
            <Button Command="{Binding CreateCommand}"
                    Content="Create"
                    HorizontalAlignment="Left"
                    Background="#B3A8E8"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="24,10"
                    CornerRadius="8">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#9D8ED6"/>
                    </Style>
                </Button.Styles>
                </Button>
        </Border>

    </Grid>
</UserControl>

