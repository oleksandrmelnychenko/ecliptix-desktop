<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.NewContent.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="500"
             x:DataType="vm:CreateSelectionViewModel"
             x:Class="Ecliptix.Core.Features.NewContent.Views.CreateSelectionView">

    <UserControl.Styles>
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>

        <Style Selector="TextBlock.category">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="4,20,0,8"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Border Background="White" Padding="32" Width="420">
        <StackPanel>

            <!-- Header Grid for Title and Close Button -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="What do you want to create?"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                </StackPanel>

                <!-- Close Button Logic -->
                <!-- Поки що просто UI елемент, можна прив'язати команду закриття оверлею, якщо потрібно -->
                <Button Grid.Column="1" Background="Transparent" Padding="4" Cursor="Hand" VerticalAlignment="Top" Margin="0,-4,-4,0">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Width="12" Height="12" Foreground="#6B7280"/>
                </Button>
            </Grid>

            <TextBlock Text="Choose the type of content or conversation you'd like to start"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type vm:CreateMenuItem}">
                            <StackPanel>

                                <!-- Category Header -->
                                <TextBlock Classes="category" Text="{Binding Category}"
                                           IsVisible="{Binding Title, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                <Button Classes="menu-item"
                                        Command="{Binding $parent[UserControl].((vm:CreateSelectionViewModel)DataContext).SelectActionCommand}"
                                        CommandParameter="{Binding ActionType}">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <!-- Icon Container -->
                                        <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
                                                Background="Transparent"
                                                VerticalAlignment="Center">
                                            <!-- BINDING TO ICON DATA -->
                                            <PathIcon Width="24" Height="24" Foreground="#1F2937"
                                                      Data="{Binding IconData}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827"
                                                       FontSize="15"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#6B7280"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
