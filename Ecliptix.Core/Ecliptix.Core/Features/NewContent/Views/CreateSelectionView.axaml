<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.NewContent.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="500"
             x:DataType="vm:CreateSelectionViewModel"
             Width="512"
             Height="382"
             x:Class="Ecliptix.Core.Features.NewContent.Views.CreateSelectionView">

<UserControl.Resources>

        <BoxShadows x:Key="DefaultItemShadow">0 2 8 0 #00000000, 0 1 2 0 #00000000</BoxShadows>
        <BoxShadows x:Key="ActiveItemShadow">0 2 8 0 #15000000, 0 1 2 0 #08000000</BoxShadows>

        <SolidColorBrush x:Key="BadgeBackground" Color="#7B61FF"/>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.menu-item:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>


        <Style Selector="Border.inner-card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BoxShadow" Value="{StaticResource DefaultItemShadow}"/>
            <Setter Property="ClipToBounds" Value="False"/>

            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>


        <Style Selector="Button.menu-item:pointerover Border.inner-card">
            <Setter Property="BoxShadow" Value="{StaticResource ActiveItemShadow}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style Selector="Button.menu-item:pressed Border.inner-card">
            <Setter Property="BoxShadow" Value="{StaticResource ActiveItemShadow}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style Selector="Button.menu-item Border#PinIndicator">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                 <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                 </Transitions>
            </Setter>
        </Style>

        <!-- Button hovered OR pressed -> Show Pin -->
        <Style Selector="Button.menu-item:pointerover Border#PinIndicator">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.menu-item:pressed Border#PinIndicator">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="TextBlock.category">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </UserControl.Styles>

    <Border Background="White" Padding="24" ClipToBounds="False">
        <StackPanel Spacing="4" ClipToBounds="False">

            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="What do you want to create?"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>
                </StackPanel>

                <Button Grid.Column="1" Background="Transparent" Padding="4" Cursor="Hand" VerticalAlignment="Top" Margin="0,-4,-4,0">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Width="12" Height="12" Foreground="#6B7280"/>
                </Button>
            </Grid>

            <TextBlock Text="Choose the type of content or conversation you'd like to start"
                       FontSize="12"
                       Foreground="#6B7280"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}" ClipToBounds="False">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type vm:CreateMenuItem}">
                            <StackPanel ClipToBounds="False">

                                <TextBlock Classes="category" Text="{Binding Category}"
                                           IsVisible="{Binding IsFirstInCategory}"/>

                                <Button Classes="menu-item"
                                        Command="{Binding $parent[UserControl].((vm:CreateSelectionViewModel)DataContext).SelectActionCommand}"
                                        CommandParameter="{Binding ActionType}">

                                    <Border Classes="inner-card">
                                        <Grid ColumnDefinitions="4, Auto, *">

                                            <Border Grid.Column="0"
                                                    Name="PinIndicator"
                                                    Width="4"
                                                    Height="24"
                                                    Background="{StaticResource BadgeBackground}"
                                                    CornerRadius="0,2,2,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" Width="40" Height="40" Margin="12,0,16,0"
                                                    Background="Transparent"
                                                    VerticalAlignment="Center">

                                                <PathIcon Width="18" Height="18" Foreground="#1F2937"
                                                          Data="{Binding IconData}"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           FontSize="15"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#6B7280"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
