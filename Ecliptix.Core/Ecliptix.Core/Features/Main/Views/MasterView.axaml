<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Main.ViewModels"
             xmlns:views="clr-namespace:Ecliptix.Core.Features.Main.Views.Components"
             xmlns:nav="clr-namespace:Ecliptix.Core.Controls.Navigation"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:DataType="vm:MasterViewModel"
             x:Class="Ecliptix.Core.Features.Main.Views.MasterView"
             x:Name="MasterViewControl">

    <!--<UserControl.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E6F3FF" Offset="0.0" />
            <GradientStop Color="#F0F8FF" Offset="0.25" />
            <GradientStop Color="#FFF5E6" Offset="0.5" />
            <GradientStop Color="#F0F8FF" Offset="0.75" />
            <GradientStop Color="#E6F3FF" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Background>-->

    <Grid ColumnDefinitions="Auto,*"
          Margin="0,0,0,0">

        <nav:NavigationSidebar Grid.Column="0"
                               DataContext="{Binding NavigationSidebar}"
                               VerticalAlignment="Stretch"
                               ZIndex="1000" />

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        ZIndex="0" />

        <!-- Profile Menu Overlay -->
        <Border Grid.ColumnSpan="2"
                Background="#33000000"
                IsVisible="{Binding NavigationSidebar.IsProfileMenuOpen}"
                Opacity="0"
                ZIndex="2000"
                Cursor="Hand"
                PointerPressed="OnOverlayClicked">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Border[IsVisible=True]">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="Border[IsVisible=False]">
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Border.Styles>
        </Border>

        <!-- Profile Menu Popup -->
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding NavigationSidebar.IsProfileMenuOpen}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="100,0,0,60"
                Width="280"
                Background="#FCFEFF"
                BorderBrush="#E8E8E8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                ZIndex="3000">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="20"
                                  Opacity="0.15"
                                  OffsetX="0"
                                  OffsetY="4" />
            </Border.Effect>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Border">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="translateY(0)" />
                </Style>
            </Border.Styles>

            <StackPanel Spacing="8">
                <!-- Add Account Option -->
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10"
                        HorizontalContentAlignment="Left"
                        CornerRadius="8"
                        Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#F2F6F7" />
                        </Style>
                    </Button.Styles>
                    <TextBlock Text="Добавить существующую учетную запись"
                               FontSize="13"
                               Foreground="#242424"
                               TextWrapping="Wrap" />
                </Button>

                <!-- Separator -->
                <Border Height="1" Background="#E8E8E8" Margin="8,4" />

                <!-- Logout Option -->
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="12,10"
                        HorizontalContentAlignment="Left"
                        CornerRadius="8"
                        Cursor="Hand"
                        Command="{Binding NavigationSidebar.LogoutCommand}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#F2F6F7" />
                        </Style>
                    </Button.Styles>
                    <TextBlock FontSize="13" Foreground="#242424">
                        <Run Text="Выйти из учетной записи" />
                        <LineBreak />
                        <Run Text="@oleksandr55555" Foreground="#5C5C5C" />
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- Logout Button at Bottom Right - On top -->
        <!--<Button Grid.Row="0"
                Command="{Binding LogoutCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Width="120"
                Height="40"
                Background="{DynamicResource Error}"
                CornerRadius="8"
                ToolTip.Tip="Logout"
                ZIndex="999">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <PathIcon Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4m7 14l5-5-5-5m5 5H9"
                          Foreground="{DynamicResource OnError}"
                          Width="20"
                          Height="20" />
                <TextBlock Text="Logout"
                           Foreground="{DynamicResource OnError}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>-->
    </Grid>
</UserControl>
