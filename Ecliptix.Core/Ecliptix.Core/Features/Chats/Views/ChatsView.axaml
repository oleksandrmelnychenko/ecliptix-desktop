<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Chats.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             x:DataType="vm:ChatsViewModel"
             x:Class="Ecliptix.Core.Features.Chats.Views.ChatsView">

    <UserControl.Styles>
        <Style Selector="Border.shimmer-gradient">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#E0E0E0" Offset="0.0"/>
                    <GradientStop Color="#F5F5F5" Offset="0.5"/>
                    <GradientStop Color="#E0E0E0" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter>

            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Background">
                            <LinearGradientBrush StartPoint="-100%,50%" EndPoint="0%,50%">
                                <GradientStop Color="#E0E0E0" Offset="0.0"/>
                                <GradientStop Color="#F5F5F5" Offset="0.5"/>
                                <GradientStop Color="#E0E0E0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Background">
                            <LinearGradientBrush StartPoint="100%,50%" EndPoint="200%,50%">
                                <GradientStop Color="#E0E0E0" Offset="0.0"/>
                                <GradientStop Color="#F5F5F5" Offset="0.5"/>
                                <GradientStop Color="#E0E0E0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.shimmer-pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.4"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.4"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Background="Transparent"
                Margin="20"
                CornerRadius="12"
                Padding="40">

            <StackPanel Spacing="20"
                        VerticalAlignment="Top">

                <TextBlock Text="{Binding Title}"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Left" />

                <ListBox ItemsSource="{Binding Conversations}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="14"
                                       Foreground="#666666"
                                       Padding="10" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Separator Margin="0, 20" />

                <Grid ColumnDefinitions="1*, 2*">

                    <StackPanel Grid.Column="0"
                                Spacing="15"
                                VerticalAlignment="Top"
                                Margin="0 0 20 0">

                        <TextBlock Text="Find new chat"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <TextBox Text="{Binding PhoneNumberInput}"
                                 Watermark="Enter phone number..."
                                 FontSize="14"
                                 MinWidth="250"/>

                        <Button Content="Find"
                                Command="{Binding FindCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <Grid Grid.Column="1"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Left">

                        <Border Background="#F0F0F0"
                                CornerRadius="8"
                                Padding="20"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                MinWidth="300"
                                IsVisible="{Binding IsLoading}">

                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="30"
                                        Background="#E0E0E0"
                                        Classes="shimmer-pulse"/>

                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <Border Width="120"
                                            Height="20"
                                            CornerRadius="4"
                                            Classes="shimmer-gradient"/>

                                    <Border Width="90"
                                            Height="16"
                                            CornerRadius="4"
                                            Classes="shimmer-gradient"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#F0F0F0"
                                CornerRadius="8"
                                Padding="20"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                MinWidth="300"
                                IsVisible="{Binding FoundUser, Converter={x:Static ObjectConverters.IsNotNull}}">

                            <StackPanel Orientation="Horizontal" Spacing="15" DataContext="{Binding FoundUser}">
                                <Border Width="60" Height="60" CornerRadius="30" Background="Gray">
                                    <TextBlock Text="{Binding Initials}"
                                               FontSize="24" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nickname}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PhoneNumber}" FontSize="14" Foreground="#555" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>

                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
