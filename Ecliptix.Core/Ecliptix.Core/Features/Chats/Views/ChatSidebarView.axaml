<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Core.Features.Chats.ViewModels"
             xmlns:converters="clr-namespace:Ecliptix.Core.Features.Chats.Converters"
             xmlns:models="clr-namespace:Ecliptix.Core.Features.Chats.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ecliptix.Core.Features.Chats.Views.ChatSidebarView"
             x:DataType="viewModels:ChatSidebarViewModel">
  <UserControl.Resources>
        <converters:ChatTypeToCornerRadiusConverter x:Key="ChatTypeToCornerRadiusConverter"/>

        <SolidColorBrush x:Key="SidebarBackground" Color="#FEFEFE" />
        <SolidColorBrush x:Key="SelectedItemBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HoverItemBackground" Color="#F7F9FA" />
        <SolidColorBrush x:Key="PrimaryText" Color="#242424"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#9E9E9E"/> <SolidColorBrush x:Key="BadgeBackground" Color="#5856D6"/>
        <SolidColorBrush x:Key="StarColor" Color="#6a5acd"/>
        <SolidColorBrush x:Key="BadgeText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnlineStatus" Color="#44B700"/>
        <SolidColorBrush x:Key="GroupIconBackground" Color="#F0F0FF"/>

        <BoxShadows x:Key="DefaultItemShadow">0 2 8 0 #00000000, 0 1 2 0 #00000000</BoxShadows>
        <BoxShadows x:Key="ActiveItemShadow">0 2 8 0 #15000000, 0 1 2 0 #08000000</BoxShadows>

        <StreamGeometry x:Key="StarIconGeometry">M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="ToggleButton.star">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.star PathIcon">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.star PathIcon">
            <Setter Property="Foreground" Value="Transparent"/>
        </Style>

        <Style Selector="ToggleButton.star:pointerover PathIcon">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        </Style>

        <Style Selector="ToggleButton.star:checked PathIcon">
            <Setter Property="Foreground" Value="{StaticResource StarColor}"/>
        </Style>

        <Style Selector="ToggleButton.star:checked:pointerover PathIcon">
            <Setter Property="Foreground" Value="{StaticResource StarColor}"/>
            </Style>


        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto, *" x:DataType="viewModels:ChatListItemViewModel">

                        <ToggleButton Grid.Column="0"
                                      Classes="star"
                                      IsChecked="{Binding IsPinned}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"> <PathIcon Data="{StaticResource StarIconGeometry}"
                                      Width="14" Height="14" />
                        </ToggleButton>

                        <Border Grid.Column="1"
                                Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="0"
                                BoxShadow="{StaticResource DefaultItemShadow}">

                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>

                            <Panel>
                                <Border Name="ActiveIndicator"
                                        Width="4" Height="24"
                                        Background="{StaticResource BadgeBackground}"
                                        CornerRadius="0,2,2,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsVisible="False"/>

                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Margin="12,10,10,10"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  CornerRadius="12"/>
                            </Panel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ Border#CardBorder">
            <Setter Property="Background" Value="{StaticResource HoverItemBackground}" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ Border#CardBorder">
            <Setter Property="Background" Value="{StaticResource SelectedItemBackground}" />
            <Setter Property="BoxShadow" Value="{StaticResource ActiveItemShadow}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#ActiveIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="ListBoxItem:selected:pointerover /template/ Border#CardBorder">
            <Setter Property="Background" Value="{StaticResource SelectedItemBackground}" />
            <Setter Property="BoxShadow" Value="{StaticResource ActiveItemShadow}" />
        </Style>

        <Style Selector="ListBoxItem:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

    </UserControl.Styles>


    <Border Background="{StaticResource SidebarBackground}" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">

            <TextBlock Text="Messages"
                       Margin="20,24,0,16"
                       FontWeight="Bold"
                       FontSize="20"
                       Foreground="{StaticResource PrimaryText}"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Chats}"
                     SelectedItem="{Binding SelectedChat}"
                     Background="Transparent"
                     SelectionMode="Single"
                     ClipToBounds="False"
                     Padding="8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ChatListItemViewModel">
                        <Grid ColumnDefinitions="Auto, *">

                            <Panel Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                                <Border CornerRadius="{Binding Type, Converter={StaticResource ChatTypeToCornerRadiusConverter}}"
                                        ClipToBounds="True"
                                        Width="48" Height="48">
                                    <Panel>
                                        <Border Background="{StaticResource HoverItemBackground}"
                                                IsVisible="{Binding AvatarImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                        <Border Background="{StaticResource GroupIconBackground}"
                                                IsVisible="{Binding Type, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static models:ChatType.Personal}}"/>

                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                               IsVisible="{Binding AvatarImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                        <Panel IsVisible="{Binding AvatarImage, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="{Binding Initials}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ChatType.Personal}}" />

                                            <TextBlock Text="#"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       FontWeight="Bold" FontSize="20" Foreground="{StaticResource BadgeBackground}"
                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static models:ChatType.Personal}}" />
                                        </Panel>
                                    </Panel>
                                </Border>

                                <Border Width="14" Height="14"
                                        CornerRadius="7"
                                        Background="{StaticResource OnlineStatus}"
                                        BorderBrush="White" BorderThickness="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,0,2">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsOnline"/>
                                            <Binding Path="Type" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="{x:Static models:ChatType.Personal}"/>
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>
                            </Panel>

                            <Grid Grid.Column="1" RowDefinitions="Auto, Auto" Margin="12,2,0,2">

                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="{StaticResource PrimaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <Border Grid.Column="1"
                                            Background="{StaticResource BadgeBackground}"
                                            CornerRadius="8"
                                            Width="16" Height="16"
                                            Padding="0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasUnreadMessages}">

                                        <TextBlock Text="{Binding UnreadCount}"
                                                   Foreground="{StaticResource BadgeText}"
                                                   FontSize="9"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DisplayMessage}"
                                               FontSize="13"
                                               Foreground="{StaticResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>

