<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ecliptix.Core.Features.Chats.Views.ChatInputView">
    <UserControl.Styles>
        <StyleInclude Source="/Features/Chats/Styles/ChatStyles.axaml"/>
    </UserControl.Styles>

    <Border Classes="input-container">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="56">

            <Button Grid.Column="0" Classes="icon" Margin="10,0,0,0">
                <PathIcon Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z"
                          Width="20" Height="20" Foreground="Gray"/>
            </Button>

            <TextBox Grid.Column="1" Classes="clean-input"
                     Watermark="Write a message..."
                     VerticalContentAlignment="Center" Margin="5,0"/>

            <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                    Background="#6A5ACD" Margin="0,0,8,0">
                <PathIcon Data="M4,6.03L11.5,9.25L4,8.25L4,6.03M11.5,14.75L4,17.97V15.75L11.5,14.75M2,3L2,10L17,12L2,14L2,21L23,12L2,3Z"
                          Width="18" Height="18" Foreground="White" Margin="2,0,0,0"/>
            </Button>
        </Grid>
    </Border>
</UserControl>

