<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Core.Features.Chats.ViewModels"
             xmlns:msgVm="clr-namespace:Ecliptix.Core.Features.Chats.ViewModels.Messages"
             xmlns:views="clr-namespace:Ecliptix.Core.Features.Chats.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ConversationViewModel"
             x:Class="Ecliptix.Core.Features.Chats.Views.ConversationView">
 <UserControl.Styles>
        <StyleInclude Source="/Features/Chats/Styles/ChatStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid.Background>
            <DrawingBrush TileMode="Tile" SourceRect="0,0,32,32" DestinationRect="0,0,32,32" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#406A5ACD">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Rect="15,15,2,2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Border Grid.Row="0" Background="White" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button Classes="icon"><PathIcon Data="M12,15.39L8.24,17.61L9.23,13.23L5.88,10.26L10.26,9.88L12,5.88L13.74,9.88L18.12,10.26L14.77,13.23L15.76,17.61L12,15.39M22,9.24L14.81,8.63L12,2L9.19,8.63L2,9.24L7.45,13.97L5.82,21L12,17.27L18.18,21L16.54,13.97L22,9.24Z" Width="22" Height="22" Foreground="Gray"/></Button>
                    <Button Classes="icon"><PathIcon Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12M5,13V10H2V13H5V16H8V13H5Z" Width="22" Height="22" Foreground="Gray"/></Button>
                    <Button Classes="icon"><PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Width="22" Height="22" Foreground="Gray"/></Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <TextBlock Text="@username" Foreground="Gray" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#ddd" ClipToBounds="True">
                         <Panel>
                             <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Width="24" Height="24" Foreground="Gray"/>
                         </Panel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Visible"
                      x:Name="ChatScrollViewer">

            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type msgVm:MessageViewModelBase}">
                        <Grid ColumnDefinitions="Auto, *, Auto">

                            <Border Grid.Column="0" Classes="avatar" IsVisible="{Binding !IsMine}" VerticalAlignment="Top" Margin="0,0,10,0">
                                <Panel>
                                    <PathIcon Data="M12,12 A4,4 0 0,1 12,12" Width="16" Height="16" IsVisible="{Binding SenderAvatar, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Image Source="{Binding SenderAvatar}" Stretch="UniformToFill" IsVisible="{Binding SenderAvatar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Panel>
                            </Border>

                            <StackPanel Grid.Column="1" Classes="msg-container" Classes.mine="{Binding IsMine}">

                                <views:MessageBubbleView />

                            </StackPanel>

                            <Border Grid.Column="2" Classes="avatar" IsVisible="{Binding IsMine}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock Text="ME" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <views:ChatInputView Grid.Row="2" />

    </Grid>
</UserControl>

