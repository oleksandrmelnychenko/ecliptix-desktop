<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Core.Features.Chats.ViewModels"
             xmlns:msgVm="clr-namespace:Ecliptix.Core.Features.Chats.ViewModels.Messages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ConversationViewModel"
             x:Class="Ecliptix.Core.Features.Chats.Views.ConversationView">
  <UserControl.Styles>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#10000000"/>
        </Style>

        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>

        <Style Selector="Border.input-container">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #1A6A5ACD"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.input-container:focus-within">
            <Setter Property="BorderBrush" Value="#6A5ACD"/>
            <Setter Property="BoxShadow" Value="0 4 15 0 #666A5ACD"/>
        </Style>

        <Style Selector="TextBox.clean-input">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="TextBox.clean-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.clean-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.message-bubble">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="500"/>
        </Style>

        <Style Selector="Border.incoming">
            <Setter Property="Background" Value="#F2F4F7"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="Border.outgoing">
            <Setter Property="Background" Value="#6A5ACD"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #406A5ACD"/>
        </Style>

        <Style Selector="StackPanel.msg-container">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="StackPanel.msg-container TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="StackPanel.msg-container.mine">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="StackPanel.msg-container.mine TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style Selector="Border.reply-quote">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Margin" Value="0,0,0,8"/> </Style>

        <Style Selector="Border.incoming Border.reply-quote">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#6A5ACD"/>
        </Style>
        <Style Selector="Border.incoming Border.reply-quote TextBlock">
             <Setter Property="Foreground" Value="#606060"/>
        </Style>

        <Style Selector="Border.outgoing Border.reply-quote">
            <Setter Property="Background" Value="#20000000"/>
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
        <Style Selector="Border.outgoing Border.reply-quote TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

    </UserControl.Styles>

   <Grid RowDefinitions="Auto,*,Auto">
        <Grid.Background>
            <DrawingBrush TileMode="Tile" SourceRect="0,0,32,32" DestinationRect="0,0,32,32" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#406A5ACD">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Rect="15,15,2,2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Border Grid.Row="0" Background="White" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="20,10">
            </Border>

        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Visible" x:Name="ChatScrollViewer">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.DataTemplates>

                    <DataTemplate DataType="{x:Type msgVm:SimpleMessageViewModel}">
                        <Grid ColumnDefinitions="Auto, *, Auto">

                            <Border Grid.Column="0" Classes="avatar" IsVisible="{Binding !IsMine}" VerticalAlignment="Top" Margin="0,0,10,0">
                                <Panel><PathIcon Data="M12,12 A4,4 0 0,1 12,12" Width="16" Height="16"/></Panel>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Classes="msg-container"
                                        Classes.mine="{Binding IsMine}">

                                <Border Classes="message-bubble"
                                        Classes.incoming="{Binding !IsMine}"
                                        Classes.outgoing="{Binding IsMine}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="Gray" Margin="5,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Classes="avatar" IsVisible="{Binding IsMine}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock Text="ME" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type msgVm:ReplyMessageViewModel}">
                        <Grid ColumnDefinitions="Auto, *, Auto">

                             <Border Grid.Column="0" Classes="avatar" IsVisible="{Binding !IsMine}" VerticalAlignment="Top" Margin="0,0,10,0">
                                <Panel><PathIcon Data="M12,12 A4,4 0 0,1 12,12" Width="16" Height="16"/></Panel>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Classes="msg-container"
                                        Classes.mine="{Binding IsMine}">

                                <Border Classes="message-bubble"
                                        Classes.incoming="{Binding !IsMine}"
                                        Classes.outgoing="{Binding IsMine}">
                                    <StackPanel>
                                        <Border Classes="reply-quote">
                                            <StackPanel>
                                                <TextBlock Text="{Binding QuotedAuthor}" FontWeight="Bold" FontSize="11" Opacity="0.8"/>
                                                <TextBlock Text="{Binding QuotedText}" FontSize="12" Opacity="0.7"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="Gray" Margin="5,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Classes="avatar" IsVisible="{Binding IsMine}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock Text="ME" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                        </Grid>
                    </DataTemplate>

                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="input-container">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
                <Button Grid.Column="0" Classes="icon" Margin="10,0,0,0"><PathIcon Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z" Width="20" Height="20" Foreground="Gray"/></Button>
                <TextBox Grid.Column="1" Classes="clean-input" Watermark="Write a message..." VerticalContentAlignment="Center" Margin="5,0"/>
                <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20" Background="#6A5ACD" Margin="0,0,8,0"><PathIcon Data="M4,6.03L11.5,9.25L4,8.25L4,6.03M11.5,14.75L4,17.97V15.75L11.5,14.75M2,3L2,10L17,12L2,14L2,21L23,12L2,3Z" Width="18" Height="18" Foreground="White" Margin="2,0,0,0"/></Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>

