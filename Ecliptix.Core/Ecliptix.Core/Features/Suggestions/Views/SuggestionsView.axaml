<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:Ecliptix.Core.Features.Suggestions.ViewModels"
			 x:DataType="vm:SuggestionsViewModel"
			 x:Class="Ecliptix.Core.Features.Suggestions.Views.SuggestionsView">

	<Grid Width="320" Background="LightGray">

		<Grid Margin="24"
			  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
			  Background="White">

			<StackPanel Grid.Row="0"
						Margin="20,20,20,8"
						Height="40"
						Spacing="12"
						Orientation="Horizontal">

				<Grid Width="40" Height="40">
					<Path Stroke="#111827"
						  VerticalAlignment="Center"
						  HorizontalAlignment="Center"
						  StrokeThickness="2"
						  StrokeLineCap="Round"
						  Data="M16 7 H22 V13
						  M22 7 L13.5 15.5 L8.5 10.5 L2 17"
						  Width="24"
						  Height="24"
						  Stretch="None"/>
				</Grid>

				<TextBlock Text="Trending Now"
						   FontWeight="600"
						   LineHeight="22.5"
						   VerticalAlignment="Center"
						   Foreground="#101828"
						   FontSize="15" />
			</StackPanel>

			<ItemsControl Grid.Row="1"
						  Margin="0,0,0,0"
						  ItemsSource="{Binding TrendingItems}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Margin="0,0,0,8"
								Height="114.5"
								Width="248"
								CornerRadius="14"
								Background="#f5f5f5">

							<Grid Margin="12"
								  ColumnDefinitions="Auto,Auto"
								  ColumnSpacing="12"
								  Background="Cyan">

								<Border Grid.Column="0"
										VerticalAlignment="Top"
										HorizontalAlignment="Center"
										Width="48"
										Height="48"
										CornerRadius="30"
										Background="#C37BFF">

									<Border VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Width="44"
											Height="44"
											CornerRadius="30"
											Background="#fff">

										<Border	VerticalAlignment="Center"
												HorizontalAlignment="Center"
												Width="40"
												Height="40"
												CornerRadius="30"
												ClipToBounds="True"
												Background="#8a7ae0">
											<Panel>
												<Image asyncImageLoader:ImageLoader.Source="{Binding Author.AvatarUrl}"
													   Stretch="Fill"
													   IsVisible="{Binding Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
												<TextBlock Text="{Binding Author.DisplayName, Converter={StaticResource InitialsConverter}}"
														   FontSize="16"
														   Foreground="#fff"
														   FontWeight="SemiBold"
														   HorizontalAlignment="Center"
														   VerticalAlignment="Center"
														   IsVisible="{Binding Author.AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}" />
											</Panel>
										</Border>
									</Border>
								</Border>

								<Grid Grid.Column="1"
									  RowDefinitions="Auto,Auto,Auto"
									  ColumnDefinitions="*,Auto"
									  ColumnSpacing="8">

									<StackPanel Orientation="Vertical"
												Height="40.5"
												Width="88.28">

										<TextBlock Text="{Binding Author.DisplayName}"
												   FontSize="14"
												   FontWeight="600"
												   LineHeight="21"
												   TextWrapping="NoWrap"
												   TextTrimming="CharacterEllipsis"
												   Foreground="#101828" />
										<TextBlock Text="{Binding Author.Username, StringFormat='@{0}'}"
												   FontSize="13"
												   TextTrimming="CharacterEllipsis"
												   TextWrapping="NoWrap"
												   LineHeight="19.5"
												   Foreground="#6a7282" />
									</StackPanel>

									<Button Grid.Column="1"
											Grid.Row="0"
											Content="Follow"
											Height="28"
											Width="67.72"
											FontSize="12"
											FontWeight="600"
											VerticalAlignment="Top"
											CornerRadius="20"
											Foreground="#fff"
											Background="#000">

									</Button>

									<TextBlock Grid.Column="0"
											   Grid.Row="1"
											   Grid.ColumnSpan="2"
											   FontSize="12"
											   Text="{Binding Title}"
											   Foreground="#4a5565"
											   VerticalAlignment="Center"
											   Margin="0,6,0,0"/>

									<StackPanel Grid.Column="0"
												Grid.Row="2"
												Grid.ColumnSpan="2"
												Margin="0,8,0,0"
												Spacing="6"
												Orientation="Horizontal">

										<Grid Width="12" Height="12">
											<Path Stroke="#98A2B3"
												  StrokeThickness="1"
												  StrokeLineCap="Round"
												  VerticalAlignment="Center"
												  HorizontalAlignment="Center"
												  Stretch="None"
												  Data="
												  M8 10.5
												  v-0.5
												  a2 2 0 0 0-2-2
												  H3
												  a2 2 0 0 0-2 2
												  v1

												  M8 1.564
												  a2 2 0 0 1 0 3.872

												  M11 10.5
												  v-1
												  a2 2 0 0 0-1.5-1.935

												  M4.5 3.5
												  a2 2 0 1 0 0.001 0
												  "/>
										</Grid>

										<TextBlock FontSize="11"
												   Foreground="#6a7282"
												   TextWrapping="Wrap">
											<Run Text="{Binding MutualConnectionsCount}"/>
											<Run Text=" mutual connections"/>
										</TextBlock>
									</StackPanel>
								</Grid>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<StackPanel Grid.Row="2"
						Margin="20,20,20,8"
						Height="40"
						Spacing="12"
						Orientation="Horizontal">

				<Grid Width="40" Height="40">

					<Path Stroke="Black"
						  StrokeThickness="2"
						  StrokeLineCap="Round"
						  Stretch="None"
						  VerticalAlignment="Center"
						  HorizontalAlignment="Center"
						  Data="
						  M11.017,2.814
						  a1,1 0 0 1 1.966,0
						  l1.051,5.558
						  a2,2 0 0 0 1.594,1.594
						  l5.558,1.051
						  a1,1 0 0 1 0,1.966
						  l-5.558,1.051
						  a2,2 0 0 0-1.594,1.594
						  l-1.051,5.558
						  a1,1 0 0 1-1.966,0
						  l-1.051-5.558
						  a2,2 0 0 0-1.594-1.594
						  l-5.558-1.051
						  a1,1 0 0 1 0-1.966
						  l5.558-1.051
						  a2,2 0 0 0 1.594-1.594
						  z
						  M20,2 L20,6
						  M22,4 L18,4
						  M4,20 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0
						  " />
				</Grid>

				<TextBlock Text="You Might Like"
						   FontWeight="600"
						   LineHeight="22.5"
						   VerticalAlignment="Center"
						   Foreground="#101828"
						   FontSize="15" />
			</StackPanel>

			<Button Grid.Row="4"
					Content="Show more suggestions"
					Foreground="#6a5acd"
					Height="45"
					FontSize="14"
					FontWeight="600"
					HorizontalAlignment="Stretch"/>
		</Grid>
	</Grid>
</UserControl>
