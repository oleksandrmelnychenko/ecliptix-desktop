<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreControls="clr-namespace:Ecliptix.Core.Controls.Core"
             xmlns:signUp="clr-namespace:Ecliptix.Core.Features.Authentication.ViewModels.Registration"
             xmlns:hintedTextControls="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="signUp:SecureKeyVerifierViewModel"
             x:Class="Ecliptix.Core.Features.Authentication.Views.Registration.SecureKeyConfirmationView"
             MinWidth="{StaticResource Content.MaxWidth}"
             Width="{StaticResource Content.MaxWidth}">

    <UserControl.Styles>
        <StyleInclude Source="avares://Ecliptix.Core/Controls/Core/HintedTextControls/Shared/CompleteProfileIcons.axaml"></StyleInclude>

        <Style Selector="Ellipse.success">
            <Setter Property="Fill" Value="#22C55E"/> </Style>
        <Style Selector="Ellipse.default">
            <Setter Property="Fill" Value="#9747FF"/> </Style>

        <Style Selector="Border.tipsBlock">
            <Setter Property="Background" Value="#F8F0FF"/>
            <Setter Property="BorderBrush" Value="#EAD5FF"/>
        </Style>
        <Style Selector="Border.tipsBlock.successState">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto" RowSpacing="{StaticResource Spacing.Authentication}">
        <StackPanel Grid.Row="0" Spacing="{StaticResource Spacing.S}" MaxWidth="{StaticResource Header.MaxWidth}" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource Font.XXL}"
                           FontWeight="Light"
                           Foreground="{DynamicResource OnSurface}"
                           LineHeight="{StaticResource LineHeight.Loose}" />
                <coreControls:StepBadgeView Text="{Binding StepBadgeText}"
                                            VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource Font.XXXL}"
                       LineHeight="{StaticResource LineHeight.Subtitle}"
                       FontWeight="Light"
                       Foreground="{DynamicResource OnSurface}"
                       Opacity="0.8" />
        </StackPanel>
        <hintedTextControls:HintedPasswordBox
            Grid.Row="1"
            x:Name="SecureKeyTextBox"
            IsSecureKeyMode="True"
            IsSecureKeyStrengthMode="{Binding HasSecureKeyBeenTouched}"
            SecureKeyStrength="{Binding CurrentSecureKeyStrength}"
            SecureKeyStrengthText="{Binding SecureKeyStrengthMessage}"
            Watermark="{Binding  SecureKeyPlaceholder}"
            Hint="{Binding SecureKeyHint}"
            ErrorText="{Binding SecureKeyError, Mode=OneWay}"
            HasError="{Binding HasSecureKeyError, Mode=OneWay}"
            Height="{StaticResource Input.SecureHeight}"
            CornerRadius="{StaticResource Input.CornerRadius}"
            FontSize="{StaticResource Input.SecureFontSize}"
            FontWeight="Light"
            TextForeground="{DynamicResource OnSurface}"
            HintForeground="{DynamicResource Primary}"
            MaxLength="28"
            VisualIcon="{DynamicResource __lock}"/>

        <hintedTextControls:HintedPasswordBox
            Grid.Row="2"
            x:Name="VerifySecureKeyTextBox"
            IsSecureKeyMode="True"
            Watermark="{Binding VerifySecureKeyPlaceholder}"
            Hint="{Binding VerifySecureKeyHint}"
            ErrorText="{Binding VerifySecureKeyError, Mode=OneWay}"
            HasError="{Binding HasVerifySecureKeyError, Mode=OneWay}"
            Height="{StaticResource Input.SecureHeight}"
            CornerRadius="{StaticResource Input.CornerRadius}"
            FontSize="{StaticResource Input.SecureFontSize}"
            FontWeight="Light"
            TextForeground="{DynamicResource OnSurface}"
            HintForeground="{DynamicResource Primary}"
            MaxLength="28"
            VisualIcon="{DynamicResource __lock_keyhole}"/>

        <Border Grid.Row="3"
                Height="150"
                Classes="tipsBlock"
                Classes.successState="{Binding IsSecureKeySuccess}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,4,0,4">

            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,12,16,8">
                    <Panel Width="18" Height="18">
                        <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                  Foreground="#9747FF"
                                  IsVisible="{Binding !IsSecureKeySuccess}"/>
                        <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                  Foreground="#16A34A"
                                  IsVisible="{Binding IsSecureKeySuccess}"/>
                    </Panel>

                    <TextBlock IsVisible="{Binding !IsSecureKeySuccess}"
                               Text="{Binding RequirementsTitle}"
                               Foreground="#9747FF"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <TextBlock IsVisible="{Binding IsSecureKeySuccess}"
                               Text="{Binding RequirementsSuccessTitle}"
                               Foreground="#16A34A"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </StackPanel>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding ValidationTips}"
                              Margin="16,0,16,12">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4,8,4">

                                <Panel Grid.Column="0"
                                       Width="14" Height="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                              Foreground="#FF6B6B"
                                              Width="10" Height="10"
                                              IsVisible="{Binding !IsMet}"/>
                                    <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Foreground="#32CD32"
                                              Width="12" Height="12"
                                              IsVisible="{Binding IsMet}"/>
                                </Panel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           Classes.met="{Binding IsMet}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="16"
                                           VerticalAlignment="Center">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Foreground" Value="#5A5A5A"/>
                                        </Style>
                                        <Style Selector="TextBlock.met">
                                            <Setter Property="Foreground" Value="#32CD32"/>
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Button
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            Height="{StaticResource Button.Height}"
            FontWeight="Medium"
            FontSize="{StaticResource Button.FontSize}"
            CornerRadius="{StaticResource Button.CornerRadius}"
            BorderThickness="0"
            Background="{DynamicResource Secondary}"
            Foreground="{DynamicResource OnSecondary}"
            Command="{Binding SubmitCommand}"
            Content="{Binding ButtonText}"
            IsEnabled="{Binding CanSubmit}"
            Classes="primary large glow"
            Classes.is-busy="{Binding IsBusy}"
            />
        <coreControls:ErrorNotificationView
            Grid.Row="5"
            x:Name="ErrorNotification"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,0"/>
    </Grid>
</UserControl>
