<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreControls="clr-namespace:Ecliptix.Core.Controls.Core"
             xmlns:signUp="clr-namespace:Ecliptix.Core.Features.Authentication.ViewModels.Registration"
             xmlns:hintedTextControls="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="signUp:SecureKeyVerifierViewModel"
             x:Class="Ecliptix.Core.Features.Authentication.Views.Registration.SecureKeyConfirmationView"
             MinWidth="{StaticResource Content.MaxWidth}"
             Width="{StaticResource Content.MaxWidth}">

    <UserControl.Styles>
        <StyleInclude Source="avares://Ecliptix.Core/Controls/Core/HintedTextControls/Shared/CompleteProfileIcons.axaml"></StyleInclude>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Spacing.Authentication}">
        <StackPanel Grid.Row="0" Spacing="{StaticResource Spacing.S}" MaxWidth="{StaticResource Header.MaxWidth}" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource Font.XXL}"
                           FontWeight="Light"
                           Foreground="{DynamicResource OnSurface}"
                           LineHeight="{StaticResource LineHeight.Loose}" />
                <coreControls:StepBadgeView Text="{Binding StepBadgeText}"
                                            VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource Font.XXXL}"
                       LineHeight="{StaticResource LineHeight.Subtitle}"
                       FontWeight="Light"
                       Foreground="{DynamicResource OnSurface}"
                       Opacity="0.8" />
        </StackPanel>
        <hintedTextControls:HintedPasswordBox
            Grid.Row="1"
            x:Name="SecureKeyTextBox"
            IsSecureKeyMode="True"
            IsSecureKeyStrengthMode="{Binding HasSecureKeyBeenTouched}"
            SecureKeyStrength="{Binding CurrentSecureKeyStrength}"
            SecureKeyStrengthText="{Binding SecureKeyStrengthMessage}"
            Watermark="{Binding  SecureKeyPlaceholder}"
            Hint="{Binding SecureKeyHint}"
            ErrorText="{Binding SecureKeyError, Mode=OneWay}"
            HasError="{Binding HasSecureKeyError, Mode=OneWay}"
            Height="{StaticResource Input.SecureHeight}"
            CornerRadius="{StaticResource Input.CornerRadius}"
            FontSize="{StaticResource Input.SecureFontSize}"
            MainBorderBrush="Transparent"
            FontWeight="Light"
            TextForeground="{DynamicResource OnSurface}"
            HintForeground="{DynamicResource Primary}"
            Background="{DynamicResource Surface}"
            MaxLength="28"
            VisualIcon="{DynamicResource __lock}"/>

        <hintedTextControls:HintedPasswordBox
            Grid.Row="2"
            x:Name="VerifySecureKeyTextBox"
            IsSecureKeyMode="True"
            Watermark="{Binding VerifySecureKeyPlaceholder}"
            Hint="{Binding VerifySecureKeyHint}"
            ErrorText="{Binding VerifySecureKeyError, Mode=OneWay}"
            HasError="{Binding HasVerifySecureKeyError, Mode=OneWay}"
            Height="{StaticResource Input.SecureHeight}"
            CornerRadius="{StaticResource Input.CornerRadius}"
            FontSize="{StaticResource Input.SecureFontSize}"
            MainBorderBrush="Transparent"
            FontWeight="Light"
            TextForeground="{DynamicResource OnSurface}"
            HintForeground="{DynamicResource Primary}"
            Background="{DynamicResource Surface}"
            MaxLength="28"
            VisualIcon="{DynamicResource __lock_keyhole}"/>

        <Button
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            Height="{StaticResource Button.Height}"
            FontWeight="Medium"
            FontSize="{StaticResource Button.FontSize}"
            CornerRadius="{StaticResource Button.CornerRadius}"
            BorderThickness="0"
            Background="{DynamicResource Secondary}"
            Foreground="{DynamicResource OnSecondary}"
            Command="{Binding SubmitCommand}"
            Content="{Binding ButtonText}"
            IsEnabled="{Binding CanSubmit}"
            Classes="primary large glow"
            Classes.is-busy="{Binding IsBusy}"
            />
        <coreControls:ErrorNotificationView
            Grid.Row="4"
            x:Name="ErrorNotification"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,0"/>
    </Grid>
</UserControl>
