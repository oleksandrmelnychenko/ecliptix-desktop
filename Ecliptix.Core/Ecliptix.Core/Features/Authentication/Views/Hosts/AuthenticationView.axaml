<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sharedConverters="clr-namespace:Ecliptix.Core.Shared.Converters"
             xmlns:core="clr-namespace:Ecliptix.Core.Core.Controls"
             xmlns:memberships1="clr-namespace:Ecliptix.Core.Features.Authentication.ViewModels.Hosts"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="680"
             x:DataType="memberships1:AuthenticationViewModel"
             x:Class="Ecliptix.Core.Features.Authentication.Views.Hosts.AuthenticationView">

    <UserControl.Resources>
        <sharedConverters:BooleanToOpacityConverter x:Key="BoolToOpacityConverter"
                                               TrueOpacity="1.0"
                                               FalseOpacity="0" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="2"
          ClipToBounds="True">

        <Button HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding NavigateBack}"
                Margin="24,24,0,0"
                Grid.Row="0"
                Classes="ghost icon-only"
                Opacity="{Binding CanNavigateBack, Converter={StaticResource BoolToOpacityConverter}}">
            <Image Source="avares://Ecliptix.Core/Assets/Icons/UI/back-icon.png"
                   Stretch="Uniform"
                   Width="18"
                   Height="18" />
        </Button>

        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                Padding="20,10"
                Margin="0 23 0 0">
            <Svg Path="avares://Ecliptix.Core/Assets/Branding/Logos/ecliptix_logo.svg"
                 Width="{StaticResource Logo.Size}"
                 Height="{StaticResource Logo.Size}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top" />
        </Border>

        <Border Grid.Row="1">
            <Border Padding="{StaticResource ContentPadding}">
                <core:ModuleContentControl ViewModelContent="{Binding CurrentView}"
                                           Background="Transparent"
                                           Width="{StaticResource Content.MaxWidth}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           ClipToBounds="False" />
            </Border>
        </Border>

        <StackPanel Grid.Row="2"
                    Classes="footer-section"
                    Spacing="8"
                    MinHeight="60">

            <!-- Agreement Text (Terms & Privacy) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FlowDirection="LeftToRight"
                        MinHeight="20">
                <TextBlock Text="{Binding LocalizationService[Footer.AgreementPrefix]}"
                           Classes="footer"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           TextWrapping="NoWrap"
                           Margin="0,0,4,0" />
                <Button Content="{Binding LocalizationService[Footer.TermsOfService]}"
                        Command="{Binding OpenTermsOfServiceCommand}"
                        Classes="ghost"
                        Padding="0"
                        Margin="0"
                        MinWidth="0"
                        MinHeight="0"
                        Foreground="#A78BFA"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left">
                </Button>
                <TextBlock Text="{Binding LocalizationService[Footer.AgreementConjunction]}"
                           Classes="footer"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           TextWrapping="NoWrap"
                           Margin="1,0,2,0" />
                <Button Content="{Binding LocalizationService[Footer.PrivacyPolicy]}"
                        Command="{Binding OpenPrivacyPolicyCommand}"
                        Classes="ghost"
                        Padding="0"
                        Margin="0"
                        MinWidth="0"
                        MinHeight="0"
                        Foreground="#A78BFA"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left">
                </Button>
            </StackPanel>

            <!-- Copyright -->
            <TextBlock Text="{Binding LocalizationService[Footer.Copyright]}"
                       Classes="footer"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
