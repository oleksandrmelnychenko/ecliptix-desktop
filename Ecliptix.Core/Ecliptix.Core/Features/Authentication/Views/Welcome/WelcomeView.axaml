<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.Features.Authentication.ViewModels.Welcome"
             xmlns:carousels="clr-namespace:Ecliptix.Core.Controls.Carousels"
             xmlns:illustrations="clr-namespace:Ecliptix.Core.Controls.Illustrations"
             mc:Ignorable="d"
             d:DesignWidth="380"
             d:DesignHeight="480"
             x:CompileBindings="True"
             x:Class="Ecliptix.Core.Features.Authentication.Views.Welcome.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto, Auto"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Margin="{StaticResource Welcome.Container.Margin}"
          Width="{StaticResource Content.MaxWidth}">


        <carousels:WelcomeCarouselView Grid.Row="1"
                                  ItemsSource="{Binding Slides}"
                                  SelectedIndex="{Binding CurrentSlideIndex, Mode=TwoWay}"
                                  HtmlUrl="avares://Ecliptix.Core/Assets/WelcomeContent.html" />

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,0,0,16">

            <Button Grid.Column="0"
                    Content="{Binding LocalizationService[Welcome.SignInButton]}"
                    Command="{Binding NavToSignInCommand}"
                    Classes="secondary large"
                    Classes.is-busy="{Binding IsSignInBusy}"
                    MinWidth="{StaticResource Button.MinWidth}" />

            <Button Grid.Column="1"
                    Content="{Binding LocalizationService[Welcome.CreateAccountButton]}"
                    Command="{Binding NavToCreateAccountCommand}"
                    Classes="primary large glow"
                    Classes.is-busy="{Binding IsCreateAccountBusy}"
                    MinWidth="{StaticResource Button.MinWidth}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" IsVisible="True">
                <Button Background="Black"
                        Height="20"
                        Foreground="white"
                        Content="Complete"
                        Command="{Binding NavToCompleteAccountCommand}">
                </Button>

                <Button Background="Black"
                        Height="20"
                        Foreground="white"
                        Content="SecureKey"
                        Command="{Binding NavToSecureKeySetCommand}">
                </Button>

                <Button Background="Black"
                        Height="20"
                        Foreground="white"
                        Content="Welcome Back"
                        Command="{Binding NavToWelcomeBackCommand}">
                </Button>

        </StackPanel>



    </Grid>
</UserControl>
