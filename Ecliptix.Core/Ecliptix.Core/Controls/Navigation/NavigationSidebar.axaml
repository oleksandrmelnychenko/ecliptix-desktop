<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ecliptix.Core.ViewModels.Navigation"
             xmlns:models="clr-namespace:Ecliptix.Core.Models.Navigation"
             xmlns:newContent="clr-namespace:Ecliptix.Core.Features.NewContent"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="800"
             x:DataType="vm:NavigationSidebarViewModel"
             Background="Transparent"
             x:Class="Ecliptix.Core.Controls.Navigation.NavigationSidebar">

   <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/Icons/Navigation/HomeIcon.axaml" />
                <ResourceInclude Source="/Assets/Icons/Navigation/ChatsIcon.axaml" />
                <ResourceInclude Source="/Assets/Icons/Navigation/SettingsIcon.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="SidebarCollapsedWidth">60</x:Double>
            <x:Double x:Key="SidebarExpandedWidth">280</x:Double>

            <SolidColorBrush x:Key="BadgeBackgroundBrush">#7B61FF</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeForegroundBrush">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Grid.sidebar-container">
            <Setter Property="Width" Value="{StaticResource SidebarCollapsedWidth}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid.sidebar-container.expanded">
            <Setter Property="Width" Value="{StaticResource SidebarExpandedWidth}" />
        </Style>

        <Style Selector="Button.copilot-sidebar-button">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Margin" Value="8,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="40" />

            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.copilot-sidebar-button:pointerover">
            <Setter Property="Background" Value="#F2F6F7" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <Style Selector="Button.copilot-sidebar-button:pressed">
            <Setter Property="Background" Value="#F2F6F7" />
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <Style Selector="Button.copilot-sidebar-button.selected">
            <Setter Property="Background" Value="#F2F6F7" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.copilot-sidebar-button:disabled">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.copilot-sidebar-button:pressed:disabled">
             <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <Style Selector="Button.copilot-sidebar-button.selected:disabled">
            <Setter Property="Background" Value="#F2F6F7" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="Path.copilot-path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />

            <Setter Property="Stroke" Value="#5C5C5C" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />

            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Stroke" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.copilot-sidebar-button.selected Path.copilot-path">
            <Setter Property="Stroke" Value="#242424" />
        </Style>
        <Style Selector="Button.copilot-sidebar-button:pointerover Path.copilot-path">
            <Setter Property="Stroke" Value="#242424" />
        </Style>

        <Style Selector="TextBlock.copilot-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#5C5C5C" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />

            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.copilot-sidebar-button.selected TextBlock.copilot-label">
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.copilot-sidebar-button:pointerover TextBlock.copilot-label">
            <Setter Property="Foreground" Value="#242424" />
        </Style>

        <Style Selector="Grid.sidebar-container.expanded TextBlock.copilot-label">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.notification-badge">
            <Setter Property="Background" Value="{StaticResource BadgeBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="7.5" /> <Setter Property="Height" Value="15" />
            <Setter Property="MinWidth" Value="15" />
            <Setter Property="Padding" Value="2,0" /> <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.badge-text">
            <Setter Property="Foreground" Value="{StaticResource BadgeForegroundBrush}" />
            <Setter Property="FontSize" Value="9" /> <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-1,0,0" />
            <Setter Property="TextAlignment" Value="End"/>
        </Style>

        <Style Selector="Border.badge-collapsed">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="RenderTransform" Value="translate(8px, -8px)" />
        </Style>

        <Style Selector="Grid.sidebar-container.expanded Border.badge-collapsed">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(0.5)" />
        </Style>

        <Style Selector="Border.badge-expanded">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateX(-10px)" />
        </Style>
        <Style Selector="Grid.sidebar-container.expanded Border.badge-expanded">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
        </Style>

        <Style Selector="FlyoutPresenter.transparent-flyout">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />

        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto,Auto, Auto"
          Classes="sidebar-container"
          Classes.expanded="{Binding IsExpanded}">

        <StackPanel Grid.Row="0"
                    Spacing="4"
                    Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding MenuItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:NavigationMenuItem">
                        <Button Classes="copilot-sidebar-button"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding $parent[UserControl].((vm:NavigationSidebarViewModel)DataContext).NavigateCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding !Type}"
                                ToolTip.Tip="{Binding TooltipText}">

                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="12,0">

                                <Panel Grid.Column="0" Width="20" Height="20">
                                    <Path Classes="copilot-path"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource HomeIconData}"
                                          IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=feed}" />

                                    <Path Classes="copilot-path"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource ChatsIconData}"
                                          IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=chats}" />
                                    <Path Classes="copilot-path"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource SettingsIconData}"
                                          IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=settings}" />

                                    <Border Classes="notification-badge badge-collapsed"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasNotifications}">
                                        <TextBlock Classes="badge-text" Text="{Binding NotificationBadgeText}" />
                                    </Border>
                                </Panel>

                                <TextBlock Grid.Column="1"
                                           Classes="copilot-label"
                                           Text="{Binding Label}" />

                                <Border Grid.Column="2"
                                        Classes="notification-badge badge-expanded"
                                        IsVisible="{Binding HasNotifications}"
                                        Margin="0,0,0,0">
                                    <TextBlock Classes="badge-text" Text="{Binding NotificationBadgeText}" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Button Grid.Row="1"
                x:Name="CreateFlyoutButton"
                Classes="copilot-sidebar-button"
                Margin="8,12,8,2">

            <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom"
                        ShowMode="Transient"
                        FlyoutPresenterClasses="transparent-flyout">
                    <newContent:CreateMenuPopup DataContext="{Binding CreateMenuVm}" />
                </Flyout>
            </Button.Flyout>

            <Grid ColumnDefinitions="Auto, *" Margin="12,0">
                <Panel Grid.Column="0" Width="20" Height="20">
                    <Svg Path="../../Assets/plus_icon.svg"
                         Width="20"
                         Height="20"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                </Panel>

                <TextBlock Grid.Column="1"
                           Classes="copilot-label"
                           Text="Create" />
            </Grid>
        </Button>

        <Button Grid.Row="2"
                Classes="copilot-sidebar-button"
                Classes.selected="{Binding ProfileMenuItem.IsSelected}"
                Margin="8,2,8,8"
                Command="{Binding $parent[UserControl].((vm:NavigationSidebarViewModel)DataContext).NavigateCommand}"
                CommandParameter="{Binding ProfileMenuItem}">
            <Grid ColumnDefinitions="Auto, *" Margin="12,0">
                <Panel Grid.Column="0" Width="20" Height="20">
                     <Svg Path="../../Assets/profile.svg"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Panel>
                <TextBlock Grid.Column="1" Classes="copilot-label" Text="Profile" />
            </Grid>
        </Button>

        <Button Grid.Row="3"
                Classes="copilot-sidebar-button"
                Command="{Binding ToggleSidebarCommand}"
                Margin="8,12,8,12">
           <Grid>
               <TextBlock Text="NIHAO" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Grid>
        </Button>

    </Grid>
</UserControl>
