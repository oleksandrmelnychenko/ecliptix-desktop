<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:illustrations="clr-namespace:Ecliptix.Core.Controls.Illustrations"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ecliptix.Core.Controls.Illustrations.AuraProtectionSystem">
   <Design.PreviewWith>
        <Border Padding="50" Background="#F0F0F0">
            <illustrations:AuraProtectionSystem Width="320" Height="320"/>
        </Border>
    </Design.PreviewWith>

    <UserControl.Styles>
        <Style Selector="Ellipse.spin">
            <Setter Property="StrokeDashArray" Value="2, 2"/>
            <Style.Animations>
                <Animation Duration="0:0:40" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Line.pulsing-connection">
            <Setter Property="StrokeThickness" Value="2.5"/>
            <Setter Property="Stroke" Value="#A78FED"/> <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.ping-base">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style Selector="Ellipse.pulse-purple">
            <Setter Property="Stroke" Value="#A855F7"/>
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.2"/><Setter Property="ScaleTransform.ScaleY" Value="0.2"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="2%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                    <KeyFrame Cue="30%" KeySpline="0.25,0.1,0.25,1"><Setter Property="ScaleTransform.ScaleX" Value="2.5"/><Setter Property="ScaleTransform.ScaleY" Value="2.5"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.pulse-blue">
            <Setter Property="Stroke" Value="#3B82F6"/>
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="32%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="33%"><Setter Property="ScaleTransform.ScaleX" Value="0.2"/><Setter Property="ScaleTransform.ScaleY" Value="0.2"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="35%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                    <KeyFrame Cue="63%" KeySpline="0.25,0.1,0.25,1"><Setter Property="ScaleTransform.ScaleX" Value="2.5"/><Setter Property="ScaleTransform.ScaleY" Value="2.5"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.pulse-red">
            <Setter Property="Stroke" Value="#EF4444"/>
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="65%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="66%"><Setter Property="ScaleTransform.ScaleX" Value="0.2"/><Setter Property="ScaleTransform.ScaleY" Value="0.2"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="68%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                    <KeyFrame Cue="96%" KeySpline="0.25,0.1,0.25,1"><Setter Property="ScaleTransform.ScaleX" Value="2.5"/><Setter Property="ScaleTransform.ScaleY" Value="2.5"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BoxShadow" Value="0 4 6 0 #20000000"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0.0" Color="#FFFFFF"/>
                    <GradientStop Offset="0.7" Color="#FFFFFF"/>
                    <GradientStop Offset="1.0" Color="#EBF4FF"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#9333ea"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="0,4,0,0"/></Style>

        <Style Selector="Path.star"><Setter Property="Fill" Value="#6366f1"/><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Data" Value="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></Style>
        <Style Selector="Path.star-red-full"><Setter Property="Fill" Value="#EF4444"/><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Data" Value="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></Style>
        <Style Selector="Path.star-red-outline"><Setter Property="Fill" Value="Transparent"/><Setter Property="Stroke" Value="#EF4444"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Data" Value="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></Style>

        <Style Selector="Ellipse.beam">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Ellipse.beam-tl">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="2%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="-85"/><Setter Property="TranslateTransform.Y" Value="-65"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.beam-tr">
            <Style.Animations>
                <Animation Duration="0:0:2.5" IterationCount="Infinite" Delay="0:0:0.5">
                    <KeyFrame Cue="2%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="85"/><Setter Property="TranslateTransform.Y" Value="-65"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.beam-bl">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="Infinite" Delay="0:0:1">
                    <KeyFrame Cue="2%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="-85"/><Setter Property="TranslateTransform.Y" Value="55"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.beam-br">
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="Infinite" Delay="0:0:1.5">
                    <KeyFrame Cue="2%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="85"/><Setter Property="TranslateTransform.Y" Value="60"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.stream-bounce-1">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                    <KeyFrame Cue="50%" KeySpline="0.25,0.1,0.25,1"><Setter Property="TranslateTransform.Y" Value="-100"/></KeyFrame>
                    <KeyFrame Cue="100%" KeySpline="0.42,0,1,1"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.stream-bounce-2">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-100"/></KeyFrame>
                    <KeyFrame Cue="50%" KeySpline="0.42,0,1,1"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%" KeySpline="0.25,0.1,0.25,1"><Setter Property="TranslateTransform.Y" Value="-100"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="White">
        <Panel Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Ellipse Classes="spin" Width="260" Height="260"
                     Stroke="#5B9FED" StrokeThickness="2" Opacity="0.15"/>

            <Canvas Width="320" Height="320">
                <Line Classes="pulsing-connection" StartPoint="160,160" EndPoint="76,96"/>
                <Line Classes="pulsing-connection" StartPoint="160,160" EndPoint="244,100"/>
                <Line Classes="pulsing-connection" StartPoint="160,160" EndPoint="76,219"/>
                <Line Classes="pulsing-connection" StartPoint="160,160" EndPoint="244,223"/>
            </Canvas>

            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Classes="beam beam-tl" Fill="#A855F7"/>
                <Ellipse Classes="beam beam-tr" Fill="#6366F1"/>
                <Ellipse Classes="beam beam-bl" Fill="#D946EF"/>
                <Ellipse Classes="beam beam-br" Fill="#3B82F6"/>
                <Panel>
                    <Ellipse Classes="stream-bounce-1" Width="5" Height="5" Fill="#A78FED" Margin="0,0,6,0"/>
                    <Ellipse Classes="stream-bounce-2" Width="5" Height="5" Fill="#5B9FED" Margin="6,0,0,0"/>
                </Panel>
            </Panel>

            <Panel HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="80">
                <Ellipse Classes="ping-base pulse-purple"/>
                <Ellipse Classes="ping-base pulse-blue"/>
                <Ellipse Classes="ping-base pulse-red"/>
                <Image Source="avares://Ecliptix.Core/Assets/Branding/Logos/AuraLogo70x70.png" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>

            <Canvas Width="320" Height="320">

                <StackPanel Canvas.Left="136" Canvas.Top="23">
                    <Border Classes="card" BorderBrush="#C7D2FE" BorderThickness="1" Width="48" Height="37">
                        <Panel>
                            <Border Width="30" Height="18" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#A5B4FC"/><GradientStop Offset="1" Color="#C084FC"/></LinearGradientBrush></Border.Background>
                                <Path Data="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"><Path Classes="star"/><Path Classes="star"/><Path Classes="star"/></StackPanel>
                        </Panel>
                    </Border>
                    <TextBlock Classes="label" Text="Streaming"/>
                </StackPanel>

                <StackPanel Canvas.Left="46" Canvas.Top="77">
                     <Border Classes="card" BorderBrush="#E9D5FF" BorderThickness="1" Width="60" Height="38">
                         <StackPanel Spacing="4" VerticalAlignment="Center">
                             <Panel Height="5" Width="28" HorizontalAlignment="Left" Background="#D1D5DB"><Border CornerRadius="3"/></Panel>
                             <Panel Height="5" Width="18" HorizontalAlignment="Right"><Border CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%"><GradientStop Offset="0" Color="#C084FC"/><GradientStop Offset="1" Color="#60A5FA"/></LinearGradientBrush></Border.Background></Border></Panel>
                         </StackPanel>
                     </Border>
                     <TextBlock Classes="label" Text="Messages"/>
                 </StackPanel>

                 <StackPanel Canvas.Left="214" Canvas.Top="77">
                     <Border Classes="card" BorderBrush="#BFDBFE" BorderThickness="1" Width="60" Height="46">
                         <Panel>
                             <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                 <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4">
                                     <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#60A5FA"/><GradientStop Offset="1" Color="#A855F7"/></LinearGradientBrush></Border.Background>
                                     <Path Data="M4,9 L20,9 M4,15 L20,15 M10,3 L8,21 M16,3 L14,21" Stroke="White" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                 </Border>
                                 <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Spacing="2">
                                     <Border Height="3" Background="#D1D5DB" CornerRadius="1.5"/><Border Height="3" Width="15" HorizontalAlignment="Left" Background="#E5E7EB" CornerRadius="1.5"/>
                                 </StackPanel>
                             </Grid>
                             <StackPanel Orientation="Horizontal" Spacing="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-8,0"><Path Classes="star"/><Path Classes="star"/><Path Classes="star"/></StackPanel>
                         </Panel>
                     </Border>
                     <TextBlock Classes="label" Text="Communities"/>
                 </StackPanel>

                 <StackPanel Canvas.Left="46" Canvas.Top="195">
                     <Border Classes="card" BorderBrush="#FBCFE8" BorderThickness="1" Width="60" Height="48">
                         <Panel>
                             <StackPanel VerticalAlignment="Center">
                                 <Grid ColumnDefinitions="Auto, *">
                                     <Border Width="14" Height="14" CornerRadius="8">
                                         <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#C084FC"/><GradientStop Offset="1" Color="#F472B6"/></LinearGradientBrush></Border.Background>
                                     </Border>
                                     <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Spacing="2">
                                         <Border Height="2" Width="18" HorizontalAlignment="Left" Background="#9CA3AF" CornerRadius="1"/>
                                         <Border Height="2" HorizontalAlignment="Stretch" Background="#D1D5DB" CornerRadius="1"/>
                                         <Border Height="2" Width="16" HorizontalAlignment="Left" Background="#D1D5DB" CornerRadius="1"/>
                                     </StackPanel>
                                 </Grid>
                                 <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                                     <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Fill="#EC4899" Width="8" Height="8" Stretch="Uniform"/>
                                     <Border Height="2" Width="10" Background="#D1D5DB" CornerRadius="1" VerticalAlignment="Center"/>
                                 </StackPanel>
                             </StackPanel>
                             <StackPanel Orientation="Horizontal" Spacing="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-8,0">
                                 <Path Classes="star-red-full"/><Path Classes="star-red-full"/><Path Classes="star-red-outline"/>
                             </StackPanel>
                         </Panel>
                     </Border>
                     <TextBlock Classes="label" Text="Posts"/>
                 </StackPanel>

                 <StackPanel Canvas.Left="214" Canvas.Top="203">
                     <Border Classes="card" BorderBrush="#A7F3D0" BorderThickness="1" Width="60" Height="40">
                         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="-4">
                                 <Border Width="14" Height="14" CornerRadius="8" BorderBrush="White" BorderThickness="2"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#C084FC"/><GradientStop Offset="1" Color="#F472B6"/></LinearGradientBrush></Border.Background></Border>
                                 <Border Width="14" Height="14" CornerRadius="8" BorderBrush="White" BorderThickness="2"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#22D3EE"/><GradientStop Offset="1" Color="#60A5FA"/></LinearGradientBrush></Border.Background></Border>
                                 <Border Width="14" Height="14" CornerRadius="8" BorderBrush="White" BorderThickness="2"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#60A5FA"/><GradientStop Offset="1" Color="#A855F7"/></LinearGradientBrush></Border.Background></Border>
                             </StackPanel>
                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" Margin="0,4,0,0">
                                 <Border Height="2" Width="8" Background="#D1D5DB" CornerRadius="1"/><Border Height="2" Width="8" Background="#D1D5DB" CornerRadius="1"/>
                             </StackPanel>
                         </StackPanel>
                     </Border>
                     <TextBlock Classes="label" Text="Connections"/>
                 </StackPanel>
            </Canvas>

        </Panel>
    </Grid>
</UserControl>
