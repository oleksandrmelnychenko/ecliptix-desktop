<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:illustrations="clr-namespace:Ecliptix.Core.Controls.Illustrations"
             x:Class="Ecliptix.Core.Controls.Illustrations.HtmlIllustrationView"
             Width="280"
             Height="280">

    <Border Name="Container"
            CornerRadius="8"
            ClipToBounds="True"
            Width="320"
            Height="340">

        <!-- <WebView Name="WebViewControl" /> -->
        <illustrations:AuraProtectionSystem VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

    </Border>

</UserControl>
