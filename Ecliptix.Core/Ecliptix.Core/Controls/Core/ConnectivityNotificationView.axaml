<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="60"
             x:Class="Ecliptix.Core.Controls.Core.ConnectivityNotificationView"
             x:Name="Root"
             x:DataType="core:ConnectivityNotificationViewModel">

    <UserControl.Styles>
        <Style Selector="Ellipse.Pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.Offline">
            <Setter Property="Background" Value="#E5E7EB"/>
        </Style>

        <Style Selector="Border.ServerIssue">
            <Setter Property="Background" Value="#FECACA"/>
        </Style>

        <Style Selector="Border.Restored">
            <Setter Property="Background" Value="#BBF7D0"/>
        </Style>


        <Style Selector="Border#PART_TimerBar">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scaleX(1)"/>
            <Setter Property="Background" Value="#22C55E"/>
        </Style>

        <Style Selector="Border.Restored Border#PART_TimerBar">
            <Setter Property="Opacity" Value="1"/>
            <Style.Animations>
                <Animation Duration="0:0:3" FillMode="Forward" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border x:Name="MainBorder"
            CornerRadius="8"
            BoxShadow="0 4 24 4 #15000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Border x:Name="ContentBorder"
                Background="White"
                Margin="4,0,0,0"
                CornerRadius="4,8,8,4"
                ClipToBounds="True">

            <Grid>
                <Grid Margin="16,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image x:Name="StatusIcon"
                           Width="24" Height="24"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Source="{Binding StatusIconSource}"
                           Stretch="Uniform" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#111827"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextWrapping="NoWrap" />

                        <TextBlock Text="{Binding StatusDescription}"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <Button x:Name="RetryButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Command="{Binding RetryCommand}"
                            IsVisible="{Binding ShowRetryButton}">

                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#F3F4F6"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                            </Style>
                        </Button.Styles>

                        <TextBlock Text="{Binding RetryButtonText}"
                                   Foreground="#374151"
                                   FontWeight="Medium"
                                   FontSize="12"/>
                    </Button>

                    <Ellipse x:Name="StatusDot"
                             Grid.Column="3"
                             Width="8" Height="8"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Classes="Pulse"
                             Fill="#EF4444"
                             IsVisible="{Binding IssueCategory, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>

                <Border x:Name="PART_TimerBar"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Height="3"
                        Width="{Binding Bounds.Width, ElementName=ContentBorder}"
                        RenderTransformOrigin="0%,0%">
                        </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
