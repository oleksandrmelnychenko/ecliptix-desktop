<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:Ecliptix.Core.Shared.Converters"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="60"
             x:Class="Ecliptix.Core.Controls.Core.ConnectivityNotificationView"
             x:DataType="core:ConnectivityNotificationViewModel">

   <UserControl.Resources>
        <system:TimeSpan x:Key="RestoredStateDuration">0:0:3</system:TimeSpan>
        <converters:DrawingColorConverter x:Key="DrawingColorConverter" />
    </UserControl.Resources>

  <UserControl.Styles>
        <Style Selector="Border.Offline Border#IconWrapper">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
        <Style Selector="Border.ServerIssue Border#IconWrapper">
            <Setter Property="Background" Value="#FEF2F2"/>
        </Style>
        <Style Selector="Border.Restored Border#IconWrapper">
            <Setter Property="Background" Value="#ECFDF5"/>
        </Style>

        <Style Selector="Border.Offline Viewbox#InnerIconViewbox">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Border.ServerIssue Viewbox#InnerIconViewbox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Border.Restored Viewbox#InnerIconViewbox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <Style Selector="Border.Offline Image#StatusIcon">
            <Setter Property="Tag" Value="{DynamicResource __wifi_off}"/>
            <Setter Property="TextElement.Foreground" Value="#4B5563"/>
        </Style>
        <Style Selector="Border.ServerIssue Image#StatusIcon">
            <Setter Property="Tag" Value="{DynamicResource __circle_alert}"/>
            <Setter Property="TextElement.Foreground" Value="#DC2626"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Border.Restored Image#StatusIcon">
            <Setter Property="Tag" Value="{DynamicResource __wifi}"/>
            <Setter Property="TextElement.Foreground" Value="#16A34A"/>
        </Style>

        <Style Selector="Border.Offline">
            <Setter Property="Background" Value="#E5E7EB"/> </Style>

        <Style Selector="Border.ServerIssue">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#fef2f2" Offset="0"/>
                        <GradientStop Color="#fff1f2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#99fecaca"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.Restored">
             <Setter Property="Background" Value="#BBF7D0"/> </Style>

        <Style Selector="Border#MainBorder">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(-20px)"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#MainBorder.Visible">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <Style Selector="Border.ServerIssue TextBlock#StatusText">
            <Setter Property="Foreground" Value="#DC2626"/>
        </Style>
        <Style Selector="Border.ServerIssue TextBlock#DescriptionText">
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>

        <Style Selector="Border#TimerBar">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scaleX(1)"/>
            <Setter Property="Background" Value="#16A34A"/>
        </Style>
        <Style Selector="Border.Restored Border#TimerBar">
            <Setter Property="Opacity" Value="1"/>
            <Style.Animations>
                <Animation Duration="{Binding RestoredStateDuration}" FillMode="Forward" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border x:Name="MainBorder"
            CornerRadius="12"
            BoxShadow="0 4 24 4 #15000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes.Visible="{Binding IsVisible}"
            Classes.Offline="{Binding IsOffline}"
            Classes.ServerIssue="{Binding IsServerIssue}"
            Classes.Restored="{Binding IsRestored}">

        <Border Background="White"
                Margin="4,0,0,0"
                CornerRadius="8,12,12,8"
                ClipToBounds="True">
            <Grid>
                <Grid Margin="12" ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                    <Border x:Name="IconWrapper"
                            Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                        <Viewbox x:Name="InnerIconViewbox"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center">

                            <Canvas Width="24" Height="24">
                                <Image x:Name="StatusIcon"
                                       Width="24" Height="24">
                                    <Image.Source>
                                        <DrawingImage>
                                            <DrawingImage.Drawing>
                                                <MultiBinding Converter="{StaticResource DrawingColorConverter}">
                                                    <Binding Path="Tag" ElementName="StatusIcon" />
                                                    <Binding Path="(TextElement.Foreground)" ElementName="StatusIcon" />
                                                </MultiBinding>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusText"
                                   Text="{Binding StatusText}"
                                   FontFamily="{StaticResource SegoeUI}"
                                   FontWeight="SemiBold" FontSize="14" Foreground="#111827"/>
                        <TextBlock x:Name="DescriptionText"
                                   Text="{Binding StatusDescription}"
                                   FontFamily="{StaticResource SegoeUI}"
                                   FontSize="12" Foreground="#6B7280"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            IsVisible="{Binding ShowRetryButton}"
                            Command="{Binding RetryCommand}"
                            Margin="8,0,0,0" Padding="12,6" CornerRadius="8"
                            Background="Transparent" BorderBrush="#E5E7EB" BorderThickness="1">
                        <TextBlock Text="{Binding RetryButtonText}"
                                   FontFamily="{StaticResource SegoeUI}"
                                   Foreground="#374151" FontWeight="Medium" FontSize="12"/>
                    </Button>

                    <Ellipse Grid.Column="3" Width="8" Height="8" Margin="8,0,0,0" Fill="#EF4444"
                             IsVisible="{Binding IsServerIssue}">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                                        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>

                    <Button Grid.Column="4"
                            Command="{Binding CloseCommand}"
                            Margin="8,-4,-4,0"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover Path">
                                <Setter Property="Fill" Value="#111827"/>
                            </Style>
                        </Button.Styles>
                        <Path Data="M13.41,12l4.3-4.29a1,1,0,1,0-1.42-1.42L12,10.59,7.71,6.29A1,1,0,0,0,6.29,7.71L10.59,12l-4.3,4.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0L12,13.41l4.29,4.3a1,1,0,0,0,1.42,0,1,1,0,0,0,0-1.42Z"
                              Fill="#9CA3AF"
                              Width="10" Height="10"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Border x:Name="TimerBar"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Height="3" Width="{Binding $parent[Border].Bounds.Width}"
                        RenderTransformOrigin="0%,0%"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
