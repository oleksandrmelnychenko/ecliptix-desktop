<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="core:EppBadgeViewModel"
             x:Class="Ecliptix.Core.Controls.Core.EppBadgeView">

    <core:StatusBadge Classes="purple"
                      Text="{Binding Text}"
                      TooltipTitle="{Binding TooltipTitle}"
                      TooltipFeature1="{Binding TooltipFeature1}"
                      TooltipFeature2="{Binding TooltipFeature2}"
                      TooltipFeature3="{Binding TooltipFeature3}"
                      Icon="{Binding Icon}"
                      BorderThickness="0"
                      Margin="0,0,8,0"/>

</UserControl>

