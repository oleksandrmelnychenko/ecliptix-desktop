<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="core:EppBadgeViewModel"
             x:Class="Ecliptix.Core.Controls.Core.EppBadgeView">

    <core:StatusBadge Classes="purple"
                      Text="{Binding LocalizationService[EPP.Text]}"
                      TooltipTitle="{Binding LocalizationService[EPP.Title]}"
                      TooltipFeature1="{Binding LocalizationService[EPP.Feature.EndToEndEncryption]}"
                      TooltipFeature2="{Binding LocalizationService[EPP.Feature.ForwardSecrecy]}"
                      TooltipFeature3="{Binding LocalizationService[EPP.Feature.OpaqueProtocol]}"
                      Icon="{DynamicResource __shield}"
                      BorderThickness="0"
                      Margin="0,0,8,0"/>

</UserControl>

