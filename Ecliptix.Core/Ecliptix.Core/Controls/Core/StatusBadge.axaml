<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="Ecliptix.Core.Controls.Core.StatusBadge">
    <UserControl.Styles>
        <Style Selector="local|StatusBadge">
            <Setter Property="Height" Value="32"/>
            <Setter Property="BadgeBrush" Value="#6B7280"/>
            <Setter Property="BadgeBackground" Value="#F3F4F6"/>
        </Style>

        <Style Selector="local|StatusBadge.purple">
            <Setter Property="BadgeBrush" Value="#A855F7"/>
            <Setter Property="BadgeBackground" Value="#15A855F7"/>
        </Style>

        <Style Selector="local|StatusBadge.green">
            <Setter Property="BadgeBrush" Value="#10B981"/>
            <Setter Property="BadgeBackground" Value="#1510B981"/>
        </Style>

        <Style Selector="local|StatusBadge.step">
            <Setter Property="BadgeBrush" Value="#7E22CE"/>
            <Setter Property="BadgeBackground" Value="#F3E8FF"/>
        </Style>
        <Style Selector="local|StatusBadge.step /template/ Border#ContainerBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="ContainerBorder"
            CornerRadius="50"
            BorderThickness="1"
            Background="{Binding BadgeBackground, ElementName=Root}"
            BorderBrush="{Binding BadgeBrush, ElementName=Root}"
            Padding="12,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ClipToBounds="True">

        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Border.Transitions>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="False">
            <PathIcon Data="{Binding Icon, ElementName=Root}"
                      Foreground="{Binding BadgeBrush, ElementName=Root}"
                      Width="16" Height="16"
                      IsVisible="{Binding Icon, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}">
                <PathIcon.Transitions>
                    <Transitions>
                        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    </Transitions>
                </PathIcon.Transitions>
            </PathIcon>

            <TextBlock Text="{Binding Text, ElementName=Root}"
                       Foreground="{Binding BadgeBrush, ElementName=Root}"
                       FontSize="14"
                       FontWeight="Medium"
                       VerticalAlignment="Center">
                <TextBlock.Transitions>
                    <Transitions>
                        <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    </Transitions>
                </TextBlock.Transitions>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>

