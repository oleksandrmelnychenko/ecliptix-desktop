<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Ecliptix.Core.Controls.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="Ecliptix.Core.Controls.Core.StatusBadge">

   <UserControl.Resources>
        <sys:TimeSpan x:Key="BadgeAnimationDuration">0:0:0.3</sys:TimeSpan>
        <sys:TimeSpan x:Key="BadgeColorDuration">0:0:0.2</sys:TimeSpan>
        <sys:Double x:Key="BadgeFontSize">8</sys:Double>
        <Thickness x:Key="BadgePadding">8,0</Thickness>
        <Thickness x:Key="BadgeBorderThickness">1</Thickness>
        <sys:Double x:Key="BadgeIconSize">10</sys:Double>
        <sys:Double x:Key="BadgeIconSpacing">2</sys:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="local|StatusBadge">
            <Setter Property="Height" Value="18"/>
            <Setter Property="BadgeBrush" Value="#6B7280"/>
            <Setter Property="BadgeBackground" Value="#F3F4F6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="Border#ContainerBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width"
                                      Duration="{StaticResource BadgeAnimationDuration}"
                                      Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background"
                                     Duration="{StaticResource BadgeColorDuration}"/>
                    <BrushTransition Property="BorderBrush"
                                     Duration="{StaticResource BadgeColorDuration}"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="local|StatusBadge.purple">
            <Setter Property="BadgeBrush" Value="#A855F7"/>
            <Setter Property="BadgeBackground" Value="#15A855F7"/>
        </Style>
        <Style Selector="local|StatusBadge.purple Border#ContainerBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="local|StatusBadge.green">
            <Setter Property="BadgeBrush" Value="#10B981"/>
            <Setter Property="BadgeBackground" Value="#1510B981"/>
        </Style>
        <Style Selector="local|StatusBadge.step">
            <Setter Property="BadgeBrush" Value="#7E22CE"/>
            <Setter Property="BadgeBackground" Value="#F3E8FF"/>
        </Style>
        <Style Selector="local|StatusBadge.gray">
            <Setter Property="BadgeBrush" Value="#6B7280"/>
            <Setter Property="BadgeBackground" Value="#F3F4F6"/>
        </Style>
        <Style Selector="local|StatusBadge.green">
            <Setter Property="BadgeBrush" Value="#10B981"/>
            <Setter Property="BadgeBackground" Value="#1510B981"/> </Style>
        <Style Selector="local|StatusBadge.red">
            <Setter Property="BadgeBrush" Value="#EF4444"/>
            <Setter Property="BadgeBackground" Value="#15EF4444"/> </Style>
        <Style Selector="local|StatusBadge.step Border#ContainerBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <TextBlock x:Name="MeasuringBlock"
                   FontSize="{StaticResource BadgeFontSize}"
                   FontWeight="SemiBold"
                   Opacity="0"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <Border x:Name="ContainerBorder"
                CornerRadius="50"
                BorderThickness="{StaticResource BadgeBorderThickness}"
                Background="{Binding BadgeBackground, ElementName=Root}"
                BorderBrush="{Binding BadgeBrush, ElementName=Root}"
                Padding="{StaticResource BadgePadding}"
                HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Root}"
                VerticalAlignment="Center"
                ClipToBounds="True">

            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource BadgeIconSpacing}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Root}">

                <PathIcon Data="{Binding Icon, ElementName=Root}"
                          Foreground="{Binding BadgeBrush, ElementName=Root}"
                          Width="{StaticResource BadgeIconSize}"
                          Height="{StaticResource BadgeIconSize}"
                          IsVisible="{Binding Icon, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <PathIcon.Transitions>
                        <Transitions>
                            <BrushTransition Property="Foreground" Duration="{StaticResource BadgeColorDuration}"/>
                        </Transitions>
                    </PathIcon.Transitions>
                </PathIcon>

                <TextBlock Text="{Binding Text, ElementName=Root}"
                           Foreground="{Binding BadgeBrush, ElementName=Root}"
                           FontSize="{StaticResource BadgeFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Transitions>
                        <Transitions>
                            <BrushTransition Property="Foreground" Duration="{StaticResource BadgeColorDuration}"/>
                        </Transitions>
                    </TextBlock.Transitions>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

