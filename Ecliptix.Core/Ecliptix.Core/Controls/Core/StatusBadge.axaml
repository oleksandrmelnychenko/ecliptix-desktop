<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Ecliptix.Core.Controls.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="Ecliptix.Core.Controls.Core.StatusBadge">
    <UserControl.Resources>
        <sys:TimeSpan x:Key="FlyoutAnimDuration">0:0:0.200</sys:TimeSpan>
        <Thickness x:Key="BadgePadding">10,4</Thickness>
        <Thickness x:Key="BadgeBorderThickness">1</Thickness>
        <sys:Double x:Key="BadgeIconSize">14</sys:Double>
        <sys:Double x:Key="BadgeIconSpacing">4</sys:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="local|StatusBadge Border#ContainerBorder">
             <Setter Property="BorderThickness" Value="{StaticResource BadgeBorderThickness}"/>
        </Style>

        <Style Selector="local|StatusBadge">
            <Setter Property="Height" Value="28"/>
            <Setter Property="BadgeBrush" Value="#6B7280"/>
            <Setter Property="BadgeBackground" Value="#F3F4F6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="local|StatusBadge.purple">
            <Setter Property="BadgeBrush" Value="#7e22ce"/>
            <Setter Property="BadgeBackground" Value="#f3e8ff"/>
        </Style>
        <Style Selector="local|StatusBadge.purple Border#ContainerBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="local|StatusBadge.green">
            <Setter Property="BadgeBrush" Value="#15803d"/>
            <Setter Property="BadgeBackground" Value="#ecfdf5"/>
        </Style>
        <Style Selector="local|StatusBadge.green Border#ContainerBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="local|StatusBadge.red">
            <Setter Property="BadgeBrush" Value="#EF4444"/>
            <Setter Property="BadgeBackground" Value="#15EF4444"/>
        </Style>

        <Style Selector="Border.popupContent">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.9)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource FlyoutAnimDuration}" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource FlyoutAnimDuration}" Easing="BackEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.popupContent.visible">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent"> <Border x:Name="ContainerBorder"
                CornerRadius="50"
                Background="{Binding BadgeBackground, ElementName=Root}"
                BorderBrush="{Binding BadgeBrush, ElementName=Root}"
                Padding="{StaticResource BadgePadding}"
                HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Root}"
                VerticalAlignment="Center"
                ClipToBounds="True">

            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource BadgeIconSpacing}"
                        VerticalAlignment="Center">

                <Viewbox Width="{StaticResource BadgeIconSize}"
                         Height="{StaticResource BadgeIconSize}"
                         IsVisible="{Binding Icon, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Canvas Width="24" Height="24">
                        <Path Data="{Binding Icon, ElementName=Root}"
                              Stroke="{Binding BadgeBrush, ElementName=Root}"
                              StrokeThickness="2.5"
                              StrokeLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="{Binding Text, ElementName=Root}"
                           Foreground="{Binding BadgeBrush, ElementName=Root}"
                           FontSize="{Binding BadgeFontSize, ElementName=Root}"
                           FontWeight="{Binding TooltipTitleFontWeight, ElementName=Root}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Popup x:Name="InfoPopup"
               PlacementTarget="{Binding ElementName=ContainerBorder}"
               Placement="Bottom"
               VerticalOffset="4"
               IsHitTestVisible="False"
               WindowManagerAddShadowHint="False">

            <Border x:Name="PopupContentBorder"
                    Classes="popupContent"
                    Background="#faf5ff"
                    BorderBrush="#e9d5ff"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    MaxWidth="300"
                    BoxShadow="0 4 12 0 #15000000, 0 2 6 0 #10000000">

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                    <Viewbox Grid.Row="0" Grid.Column="0" Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top">
                        <Canvas Width="16" Height="16">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                                     Stroke="#9333ea" StrokeThickness="1.2" Fill="Transparent"/>
                            <Path Data="M8 4V8M8 11H8.01"
                                  Stroke="#9333ea" StrokeThickness="1.5" StrokeLineCap="Round"/>
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                        <TextBlock Text="{Binding TooltipTitle, ElementName=Root}"
                                   FontFamily="{StaticResource SegoeUI}"
                                   FontSize="{Binding PopupFontSize, ElementName=Root}"
                                   Foreground="#7e22ce"
                                   LineHeight="19.2"/>

                        <StackPanel Spacing="2" Margin="4,0,0,0">
                            <TextBlock Text="{Binding TooltipFeature1, ElementName=Root, StringFormat='• {0}'}"
                                       FontFamily="{StaticResource SegoeUI}"
                                       FontSize="{Binding PopupFontSize, ElementName=Root}"
                                       Foreground="#7e22ce"
                                       LineHeight="19.2"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TooltipFeature2, ElementName=Root, StringFormat='• {0}'}"
                                       FontFamily="{StaticResource SegoeUI}"
                                       FontSize="{Binding PopupFontSize, ElementName=Root}"
                                       Foreground="#7e22ce"
                                       LineHeight="19.2"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TooltipFeature3, ElementName=Root, StringFormat='• {0}'}"
                                       FontFamily="{StaticResource SegoeUI}"
                                       FontSize="{Binding PopupFontSize, ElementName=Root}"
                                       Foreground="#7e22ce"
                                       LineHeight="19.2"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>

