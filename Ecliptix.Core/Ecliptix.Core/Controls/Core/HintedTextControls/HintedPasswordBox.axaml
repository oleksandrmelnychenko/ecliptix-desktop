<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Ecliptix.Core.Shared.Converters"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="78"
             x:CompileBindings="True"
             x:DataType="core:HintedPasswordBox"
             x:Class="Ecliptix.Core.Controls.Core.HintedTextControls.HintedPasswordBox"
             x:Name="control"
             Focusable="False">

<UserControl.Resources>
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter"
                                              TrueOpacity="1.0"
                                              FalseOpacity="0" />

        <x:Double x:Key="MinControlHeight">56</x:Double>
        <x:Double x:Key="MinTextBoxHeight">28</x:Double>
        <x:Double x:Key="Icon.Size">16</x:Double>
        <Thickness x:Key="Icon.Margin">2</Thickness>

        <Thickness x:Key="FocusBorderThickness">1.5</Thickness>
        <Thickness x:Key="MainBorderThickness">1</Thickness>
        <Thickness x:Key="MainBorderMargin">0.75</Thickness>
        <Thickness x:Key="InnerPanelMargin">14,8,12,8</Thickness>
        <Thickness x:Key="TextBoxMargin">0,0,12,0</Thickness>
        <Thickness x:Key="CounterMargin">0,8,0,0</Thickness>
        <Thickness x:Key="HintSectionMargin">0,4,0,0</Thickness>

        <SolidColorBrush x:Key="CounterForegroundBrush">Gray</SolidColorBrush>
        <SolidColorBrush x:Key="BrushError" Color="#EF3A3A"/>

        <SolidColorBrush x:Key="BrushStrInvalid" Color="#EF3A3A"/>
        <SolidColorBrush x:Key="BrushStrVeryWeak" Color="#FF6B35"/>
        <SolidColorBrush x:Key="BrushStrWeak" Color="#FFA500"/>
        <SolidColorBrush x:Key="BrushStrGood" Color="#F4C20D"/>
        <SolidColorBrush x:Key="BrushStrStrong" Color="#00BCD4"/>
        <SolidColorBrush x:Key="BrushStrVeryStrong" Color="#32CD32"/>

        <BoxShadows x:Key="ShadowDefault">0 2 12 0 #00000000</BoxShadows>
        <BoxShadows x:Key="ShadowFocus">0 2 12 0 #996a5acd</BoxShadows>
        <BoxShadows x:Key="ShadowError">0 2 12 0 #99ef3a3a</BoxShadows>

        <BoxShadows x:Key="ShadowStrInvalid">0 2 12 0 #99ef3a3a</BoxShadows>
        <BoxShadows x:Key="ShadowStrVeryWeak">0 2 12 0 #99ff6b35</BoxShadows>
        <BoxShadows x:Key="ShadowStrWeak">0 2 12 0 #99ffa500</BoxShadows>
        <BoxShadows x:Key="ShadowStrGood">0 2 12 0 #99f4c20d</BoxShadows>
        <BoxShadows x:Key="ShadowStrStrong">0 2 12 0 #9900bcd4</BoxShadows>
        <BoxShadows x:Key="ShadowStrVeryStrong">0 2 12 0 #9932cd32</BoxShadows>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Border#FocusBorder">
             <Setter Property="Opacity" Value="0"/>
             <Setter Property="BorderBrush" Value="{Binding FocusBorderBrush, ElementName=control}"/>
        </Style>
        <Style Selector="Border#ShadowBorder">
             <Setter Property="BoxShadow" Value="{StaticResource ShadowDefault}"/>
        </Style>

        <Style Selector="TextBlock.strength-text">
             <Setter Property="FontSize" Value="12" />
             <Setter Property="VerticalAlignment" Value="Center" />
             <Setter Property="IsHitTestVisible" Value="False" />
             <Setter Property="Foreground" Value="Gray"/>
        </Style>

        <Style Selector="Path.strength-icon">
            <Setter Property="Width" Value="{StaticResource Icon.Size}" />
            <Setter Property="Height" Value="{StaticResource Icon.Size}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Icon.Margin}" />
            <Setter Property="Data" Value="{StaticResource LampIcon.Path}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Gray"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="core|HintedPasswordBox:focus-within Border#FocusBorder">
            <Setter Property="Opacity" Value="1"/>
            </Style>
        <Style Selector="core|HintedPasswordBox:focus-within Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowFocus}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox:focus-within Border#MainBorder">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.error Border#FocusBorder">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.error Border#MainBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.error Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowError}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.error:focus-within Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.error:focus-within Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowError}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.strength-invalid Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushStrInvalid}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-invalid Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowStrInvalid}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-invalid Path.strength-icon">
            <Setter Property="Fill" Value="{StaticResource BrushStrInvalid}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-invalid TextBlock.strength-text">
            <Setter Property="Foreground" Value="{StaticResource BrushStrInvalid}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.strength-very-weak Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushStrVeryWeak}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-very-weak Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowStrVeryWeak}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-very-weak Path.strength-icon">
             <Setter Property="Fill" Value="{StaticResource BrushStrVeryWeak}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-very-weak TextBlock.strength-text">
            <Setter Property="Foreground" Value="{StaticResource BrushStrVeryWeak}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.strength-weak Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushStrWeak}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-weak Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowStrWeak}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-weak Path.strength-icon">
             <Setter Property="Fill" Value="{StaticResource BrushStrWeak}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-weak TextBlock.strength-text">
            <Setter Property="Foreground" Value="{StaticResource BrushStrWeak}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.strength-good Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushStrGood}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-good Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowStrGood}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-good Path.strength-icon">
             <Setter Property="Fill" Value="{StaticResource BrushStrGood}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-good TextBlock.strength-text">
            <Setter Property="Foreground" Value="{StaticResource BrushStrGood}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.strength-strong Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushStrStrong}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-strong Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowStrStrong}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-strong Path.strength-icon">
             <Setter Property="Fill" Value="{StaticResource BrushStrStrong}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-strong TextBlock.strength-text">
            <Setter Property="Foreground" Value="{StaticResource BrushStrStrong}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.strength-very-strong Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushStrVeryStrong}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-very-strong Border#ShadowBorder">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowStrVeryStrong}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-very-strong Path.strength-icon">
             <Setter Property="Fill" Value="{StaticResource BrushStrVeryStrong}"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.strength-very-strong TextBlock.strength-text">
            <Setter Property="Foreground" Value="{StaticResource BrushStrVeryStrong}"/>
        </Style>

        <Style Selector="core|HintedPasswordBox.secure-mode Border#MainBorder">
             <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="core|HintedPasswordBox.secure-mode Border#FocusBorder">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="TextBlock.hint-text">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="TextBlock.error-text">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="StackPanel.hint-section">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="{StaticResource HintSectionMargin}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource Duration.Slow}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="StackPanel.error-section">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="{StaticResource HintSectionMargin}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{Binding Background, ElementName=control}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource Duration.Slow}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="StackPanel.warning-section">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-7,-5,0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource Duration.Fast}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="StackPanel.counter-section">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="{StaticResource CounterMargin}" />
        </Style>

        <Style Selector="Path.hint-icon">
            <Setter Property="Width" Value="{StaticResource Icon.Size}" />
            <Setter Property="Height" Value="{StaticResource Icon.Size}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Icon.Margin}" />
            <Setter Property="Data" Value="{StaticResource LampIcon.Path}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding HintForeground, ElementName=control}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="{StaticResource Brush.TransitionDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Path.error-icon">
            <Setter Property="Width" Value="{StaticResource Icon.Size}" />
            <Setter Property="Height" Value="{StaticResource Icon.Size}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Icon.Margin}" />
            <Setter Property="Data" Value="{StaticResource LampIcon.Path}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource Error}" />
             <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="{StaticResource Brush.TransitionDuration}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.counter-text">
            <Setter Property="FontSize" Value="{StaticResource Counter.FontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource CounterForegroundBrush}" />
        </Style>

        <Style Selector="TextBlock.securekey-mask-overlay">
            <Setter Property="Foreground" Value="{Binding TextForeground, ElementName=control}" />
            <Setter Property="FontSize" Value="{Binding FontSize, ElementName=control}" />
            <Setter Property="FontWeight" Value="{Binding FontWeight, ElementName=control}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="{StaticResource TextBoxMargin}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="TextBox#MainTextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{Binding TextForeground, ElementName=control}" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="{Binding WatermarkFontSize, ElementName=control}" />
            <Setter Property="FontWeight" Value="Regular" />
        </Style>

        <Style Selector="TextBox#MainTextBox">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="CaretBrush" Value="{DynamicResource OnSurface}" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="ContextFlyout" Value="{x:Null}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut" />
                    <BrushTransition Property="CaretBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox#MainTextBox:focus">
            <Setter Property="CaretBrush" Value="{DynamicResource OnSurface}" />
        </Style>

    </UserControl.Styles>

    <Grid ClipToBounds="False">

        <Border x:Name="ShadowBorder"
                Margin="{StaticResource MainBorderMargin}"
                CornerRadius="{Binding CornerRadius, ElementName=control}"
                MinHeight="{StaticResource MinControlHeight}"
                Background="Transparent">
        </Border>

        <Border x:Name="FocusBorder"
                BorderThickness="{StaticResource FocusBorderThickness}"
                Background="Transparent"
                CornerRadius="{Binding CornerRadius, ElementName=control}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource Input.OpacityDuration}" />
                    <BrushTransition Property="BorderBrush" Duration="{StaticResource Brush.TransitionDuration}" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <Border x:Name="MainBorder"
                Margin="{StaticResource MainBorderMargin}"
                BorderThickness="{StaticResource MainBorderThickness}"
                BorderBrush="{Binding MainBorderBrush, ElementName=control}"
                CornerRadius="{Binding CornerRadius, ElementName=control}"
                MinHeight="{StaticResource MinControlHeight}"
                Background="{Binding Background, ElementName=control}">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="{StaticResource Brush.TransitionDuration}" />
                </Transitions>
            </Border.Transitions>

            <Panel Margin="{StaticResource InnerPanelMargin}">
                <Grid VerticalAlignment="Stretch"
                      RowDefinitions="*,Auto">

                    <Grid Grid.Row="0">
                        <TextBox x:Name="MainTextBox"
                                 Watermark="{Binding Watermark, ElementName=control}"
                                 Foreground="{Binding TextForeground, ElementName=control}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="{StaticResource TextBoxMargin}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 FontSize="{Binding FontSize, ElementName=control}"
                                 FontWeight="{Binding FontWeight, ElementName=control}"
                                 MinHeight="{StaticResource MinTextBoxHeight}"
                                 TextWrapping="NoWrap"
                                 MaxLength="{Binding MaxLength, ElementName=control}" />

                        <TextBlock x:Name="SecureKeyMaskOverlay"
                                   Classes="securekey-mask-overlay"
                                   IsVisible="True" />

                        <StackPanel Grid.Row="0"
                                    x:Name="CounterPanel"
                                    Classes="counter-section"
                                    IsVisible="{Binding ShowCharacterCounter, ElementName=control}">
                            <TextBlock Text="{Binding RemainingCharacters, ElementName=control}"
                                       Classes="counter-text" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="HintStackPanel"
                                Grid.Row="1"
                                Classes="hint-section"
                                Orientation="Horizontal"
                                IsVisible="{Binding !IsSecureKeyStrengthMode, ElementName=control}"
                                Background="{DynamicResource Surface}">
                        <Path Classes="hint-icon"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0" />
                        <TextBlock x:Name="HintTextBlock"
                                   Text="{Binding Hint, ElementName=control}"
                                   Foreground="{Binding HintForeground, ElementName=control}"
                                   VerticalAlignment="Center"
                                   Classes="hint-text" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                x:Name="ErrorStackPanel"
                                Classes="error-section"
                                Orientation="Horizontal"
                                Opacity="{Binding EllipseOpacity, ElementName=control}"
                                Background="{DynamicResource Surface}">
                        <Path Classes="error-icon"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ErrorText, ElementName=control}"
                                   VerticalAlignment="Center"
                                   Classes="error-text" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                x:Name="SecureKeyStrengthStackPanel"
                                Classes="hint-section"
                                Orientation="Horizontal"
                                IsVisible="{Binding IsSecureKeyStrengthMode, ElementName=control}"
                                Background="{DynamicResource Surface}">
                        <Path Classes="strength-icon"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0" />
                        <TextBlock x:Name="SecureKeyStrengthTextBlock"
                                   Text="{Binding SecureKeyStrengthText, ElementName=control}"
                                   VerticalAlignment="Center"
                                   Classes="hint-text strength-text" />
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                x:Name="WarningStackPanel"
                                Classes="warning-section"
                                Opacity="{Binding HasWarning, ElementName=control, Converter={StaticResource BooleanToOpacityConverter}}">
                        <TextBlock Text="{Binding WarningText, ElementName=control}"
                                   Foreground="{DynamicResource Error}"
                                   VerticalAlignment="Center"
                                   Classes="hint-text" />
                        <Border VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                            <Ellipse Fill="{DynamicResource Error}"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Width="8"
                                     Height="8"
                                     Margin="6,2,0,0"
                                     Stretch="UniformToFill"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>
    </Grid>
</UserControl>
