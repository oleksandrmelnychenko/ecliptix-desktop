<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
             xmlns:converters="clr-namespace:Ecliptix.Core.Shared.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ecliptix.Core.Controls.Core.HintedTextControls.HintedDatePicker"
             x:Name="Control"
             Focusable="False"
             x:DataType="core:HintedDatePicker"
             >
  <UserControl.Resources>
        <converters:DrawingColorConverter x:Key="DrawingColorConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="/Controls/Core/HintedTextControls/Shared/HintedControlStyles.axaml" />

        <Style Selector="Border#FocusBorder">
            <Setter Property="BorderBrush" Value="{Binding FocusBorderBrush, ElementName=Control}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" Delay="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid.hinted-field:focus-within Border#FocusBorder,
                     Grid.hinted-field.dropdown-open Border#FocusBorder">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" Delay="0:0:0.0" /> <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Path.hint-icon">
            <Setter Property="Fill" Value="{Binding HintForeground, ElementName=Control}" />
        </Style>

        <Style Selector="StackPanel.hint-section, StackPanel.error-section">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Grid.hinted-field.error StackPanel.hint-section">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Grid.hinted-field:not(.error) StackPanel.hint-section">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

    </UserControl.Styles>

    <Grid x:Name="MainGrid"
          Classes="hinted-field"
          Classes.error="{Binding HasError, ElementName=Control}"
          Classes.dropdown-open="{Binding IsDropDownOpen, ElementName=MainDatePicker}"
          ClipToBounds="False">

        <Border x:Name="ShadowBorder"
                Margin="{StaticResource MainBorderMargin}"
                CornerRadius="{Binding CornerRadius, ElementName=Control}"
                MinHeight="{StaticResource MinControlHeight}"
                Background="Transparent"/>

        <Border x:Name="FocusBorder"
                BorderThickness="{StaticResource FocusBorderThickness}"
                Background="Transparent"
                CornerRadius="{Binding CornerRadius, ElementName=Control}">
             <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <Border x:Name="MainBorder"
                Margin="{StaticResource MainBorderMargin}"
                BorderThickness="{StaticResource MainBorderThickness}"
                CornerRadius="{Binding CornerRadius, ElementName=Control}"
                MinHeight="{StaticResource MinControlHeight}">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Border.Transitions>

            <Panel Margin="{StaticResource InnerPanelMargin}">
                <Grid VerticalAlignment="Stretch" RowDefinitions="*,Auto">

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />    </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               IsVisible="{Binding ShowVisualIcon, ElementName=Control}"
                               Width="13"
                               Height="13"
                               Margin="8,0,8,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Opacity="0.5">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <MultiBinding Converter="{StaticResource DrawingColorConverter}">
                                            <Binding Path="VisualIcon" ElementName="Control" />
                                            <Binding Path="TextForeground" ElementName="Control" />
                                            <Binding Path="VisualIconStrokeThickness" ElementName="Control" />
                                        </MultiBinding>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>

                        <Border Grid.Column="1"
                                IsVisible="{Binding ShowLeftSeparator, ElementName=Control}"
                                Width="1"
                                Margin="0,8,12,8"
                                Background="{Binding TextForeground, ElementName=Control}"
                                Opacity="0.2" />

                        <CalendarDatePicker x:Name="MainDatePicker"
                                            Grid.Column="2"
                                            SelectedDate="{Binding InternalDate, ElementName=Control, Mode=TwoWay}"
                                            Watermark="{Binding Watermark, ElementName=Control}"
                                            SelectedDateFormat="Custom"
                                            CustomDateFormatString="{Binding DateFormat, ElementName=Control}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Stretch"
                                            FontSize="{Binding FontSize, ElementName=Control}"
                                            Foreground="{Binding TextForeground, ElementName=Control}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"/>
                    </Grid>

                    <StackPanel x:Name="HintStackPanel"
                                Grid.Row="1"
                                Classes="hint-section"
                                Orientation="Horizontal">
                        <Path Classes="hint-icon" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Hint, ElementName=Control}"
                                   Foreground="{Binding HintForeground, ElementName=Control}"
                                   Classes="hint-text" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                x:Name="ErrorStackPanel"
                                Classes="error-section"
                                Opacity="{Binding EllipseOpacity, ElementName=Control}"
                                Orientation="Horizontal">
                        <Path Classes="error-icon" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ErrorText, ElementName=Control}"
                                   Classes="error-text" />
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>
    </Grid>
</UserControl>

