<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
        xmlns:auth="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
        xmlns:converters="clr-namespace:Ecliptix.Core.Shared.Converters">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

  <Styles.Resources>
        <x:Double x:Key="MinControlHeight">56</x:Double>
        <x:Double x:Key="MinTextBoxHeight">28</x:Double>
        <x:Double x:Key="Icon.Size">16</x:Double>

        <Thickness x:Key="Icon.Margin">2</Thickness>
        <Thickness x:Key="FocusBorderThickness">1.5</Thickness>
        <Thickness x:Key="MainBorderThickness">1</Thickness>
        <Thickness x:Key="MainBorderMargin">0.75</Thickness>
        <Thickness x:Key="InnerPanelMargin">14,8,12,8</Thickness>
        <Thickness x:Key="TextBoxMargin">0,0,12,0</Thickness>
        <Thickness x:Key="CounterMargin">0,8,0,0</Thickness>
        <Thickness x:Key="HintSectionMargin">0,4,0,0</Thickness>

        <SolidColorBrush x:Key="CounterForegroundBrush">Gray</SolidColorBrush>
        <SolidColorBrush x:Key="BrushError" Color="#EF3A3A"/>

        <SolidColorBrush x:Key="BrushStrInvalid" Color="#EF3A3A"/>
        <SolidColorBrush x:Key="BrushStrVeryWeak" Color="#FF6B35"/>
        <SolidColorBrush x:Key="BrushStrWeak" Color="#FFA500"/>
        <SolidColorBrush x:Key="BrushStrGood" Color="#F4C20D"/>
        <SolidColorBrush x:Key="BrushStrStrong" Color="#00BCD4"/>
        <SolidColorBrush x:Key="BrushStrVeryStrong" Color="#32CD32"/>

        <BoxShadows x:Key="ShadowDefault">0 2 12 0 #00000000</BoxShadows>
        <BoxShadows x:Key="ShadowFocus">0 2 12 0 #996a5acd</BoxShadows>
        <BoxShadows x:Key="ShadowError">0 2 12 0 #99ef3a3a</BoxShadows>

        <BoxShadows x:Key="ShadowStrInvalid">0 2 12 0 #99ef3a3a</BoxShadows>
        <BoxShadows x:Key="ShadowStrVeryWeak">0 2 12 0 #99ff6b35</BoxShadows>
        <BoxShadows x:Key="ShadowStrWeak">0 2 12 0 #99ffa500</BoxShadows>
        <BoxShadows x:Key="ShadowStrGood">0 2 12 0 #99f4c20d</BoxShadows>
        <BoxShadows x:Key="ShadowStrStrong">0 2 12 0 #9900bcd4</BoxShadows>
        <BoxShadows x:Key="ShadowStrVeryStrong">0 2 12 0 #9932cd32</BoxShadows>

        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter"
                                              TrueOpacity="1.0"
                                              FalseOpacity="0" />
    </Styles.Resources>

    <Style Selector="Border#FocusBorder">
        <Setter Property="Opacity" Value="0"/>
        </Style>

    <Style Selector="Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowDefault}"/>
    </Style>

    <Style Selector="TextBlock.hint-text">
        <Setter Property="FontSize" Value="12" /> <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TextBlock.strength-text">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="Gray"/>
    </Style>

    <Style Selector="TextBlock.error-text">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Error}" /> <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="TextBlock.counter-text">
        <Setter Property="FontSize" Value="12" /> <Setter Property="Foreground" Value="{StaticResource CounterForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.securekey-mask-overlay">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="{StaticResource TextBoxMargin}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="StackPanel.hint-section, StackPanel.error-section">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="{StaticResource HintSectionMargin}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="StackPanel.error-section">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="StackPanel.warning-section">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-7,-5,0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="StackPanel.counter-section">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{StaticResource CounterMargin}" />
    </Style>

    <Style Selector="Path.hint-icon, Path.error-icon, Path.strength-icon">
        <Setter Property="Width" Value="{StaticResource Icon.Size}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Icon.Margin}" />
        <Setter Property="Data" Value="{StaticResource LampIcon.Path}" /> <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Path.error-icon">
        <Setter Property="Fill" Value="{DynamicResource Error}" />
    </Style>

    <Style Selector="Path.strength-icon">
        <Setter Property="Fill" Value="Gray"/>
    </Style>


    <Style Selector="core|HintedTextBox:focus-within Border#FocusBorder,
                     auth|HintedPasswordBox:focus-within Border#FocusBorder">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="core|HintedTextBox:focus-within Border#ShadowBorder,
                     auth|HintedPasswordBox:focus-within Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowFocus}"/>
    </Style>

    <Style Selector="core|HintedTextBox:focus-within Border#MainBorder,
                     auth|HintedPasswordBox:focus-within Border#MainBorder">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>


    <Style Selector="core|HintedTextBox.error Border#FocusBorder,
                     auth|HintedPasswordBox.error Border#FocusBorder">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
    </Style>
    <Style Selector="core|HintedTextBox.error Border#MainBorder,
                     auth|HintedPasswordBox.error Border#MainBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
    </Style>
    <Style Selector="core|HintedTextBox.error Border#ShadowBorder,
                     auth|HintedPasswordBox.error Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowError}"/>
    </Style>

    <Style Selector="core|HintedTextBox.error:focus-within Border#FocusBorder,
                     auth|HintedPasswordBox.error:focus-within Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
    </Style>
    <Style Selector="core|HintedTextBox.error:focus-within Border#ShadowBorder,
                     auth|HintedPasswordBox.error:focus-within Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowError}"/>
    </Style>


    <Style Selector="core|HintedTextBox.secure-mode Border#MainBorder,
                     auth|HintedPasswordBox.secure-mode Border#MainBorder">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="core|HintedTextBox.secure-mode Border#FocusBorder,
                     auth|HintedPasswordBox.secure-mode Border#FocusBorder">
        <Setter Property="Opacity" Value="1"/>
    </Style>


    <Style Selector="core|HintedTextBox.strength-invalid Border#FocusBorder, auth|HintedPasswordBox.strength-invalid Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushStrInvalid}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-invalid Border#ShadowBorder, auth|HintedPasswordBox.strength-invalid Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowStrInvalid}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-invalid Path.strength-icon, auth|HintedPasswordBox.strength-invalid Path.strength-icon">
        <Setter Property="Fill" Value="{StaticResource BrushStrInvalid}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-invalid TextBlock.strength-text, auth|HintedPasswordBox.strength-invalid TextBlock.strength-text">
        <Setter Property="Foreground" Value="{StaticResource BrushStrInvalid}"/>
    </Style>

    <Style Selector="core|HintedTextBox.strength-very-weak Border#FocusBorder, auth|HintedPasswordBox.strength-very-weak Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushStrVeryWeak}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-very-weak Border#ShadowBorder, auth|HintedPasswordBox.strength-very-weak Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowStrVeryWeak}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-very-weak Path.strength-icon, auth|HintedPasswordBox.strength-very-weak Path.strength-icon">
        <Setter Property="Fill" Value="{StaticResource BrushStrVeryWeak}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-very-weak TextBlock.strength-text, auth|HintedPasswordBox.strength-very-weak TextBlock.strength-text">
        <Setter Property="Foreground" Value="{StaticResource BrushStrVeryWeak}"/>
    </Style>

    <Style Selector="core|HintedTextBox.strength-weak Border#FocusBorder, auth|HintedPasswordBox.strength-weak Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushStrWeak}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-weak Border#ShadowBorder, auth|HintedPasswordBox.strength-weak Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowStrWeak}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-weak Path.strength-icon, auth|HintedPasswordBox.strength-weak Path.strength-icon">
        <Setter Property="Fill" Value="{StaticResource BrushStrWeak}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-weak TextBlock.strength-text, auth|HintedPasswordBox.strength-weak TextBlock.strength-text">
        <Setter Property="Foreground" Value="{StaticResource BrushStrWeak}"/>
    </Style>

    <Style Selector="core|HintedTextBox.strength-good Border#FocusBorder, auth|HintedPasswordBox.strength-good Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushStrGood}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-good Border#ShadowBorder, auth|HintedPasswordBox.strength-good Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowStrGood}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-good Path.strength-icon, auth|HintedPasswordBox.strength-good Path.strength-icon">
        <Setter Property="Fill" Value="{StaticResource BrushStrGood}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-good TextBlock.strength-text, auth|HintedPasswordBox.strength-good TextBlock.strength-text">
        <Setter Property="Foreground" Value="{StaticResource BrushStrGood}"/>
    </Style>

    <Style Selector="core|HintedTextBox.strength-strong Border#FocusBorder, auth|HintedPasswordBox.strength-strong Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushStrStrong}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-strong Border#ShadowBorder, auth|HintedPasswordBox.strength-strong Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowStrStrong}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-strong Path.strength-icon, auth|HintedPasswordBox.strength-strong Path.strength-icon">
        <Setter Property="Fill" Value="{StaticResource BrushStrStrong}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-strong TextBlock.strength-text, auth|HintedPasswordBox.strength-strong TextBlock.strength-text">
        <Setter Property="Foreground" Value="{StaticResource BrushStrStrong}"/>
    </Style>

    <Style Selector="core|HintedTextBox.strength-very-strong Border#FocusBorder, auth|HintedPasswordBox.strength-very-strong Border#FocusBorder">
        <Setter Property="BorderBrush" Value="{StaticResource BrushStrVeryStrong}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-very-strong Border#ShadowBorder, auth|HintedPasswordBox.strength-very-strong Border#ShadowBorder">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowStrVeryStrong}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-very-strong Path.strength-icon, auth|HintedPasswordBox.strength-very-strong Path.strength-icon">
        <Setter Property="Fill" Value="{StaticResource BrushStrVeryStrong}"/>
    </Style>
    <Style Selector="core|HintedTextBox.strength-very-strong TextBlock.strength-text, auth|HintedPasswordBox.strength-very-strong TextBlock.strength-text">
        <Setter Property="Foreground" Value="{StaticResource BrushStrVeryStrong}"/>
    </Style>


    <Style Selector="TextBox#MainTextBox">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurface}" />
        <Setter Property="ContextMenu" Value="{x:Null}" />
        <Setter Property="ContextFlyout" Value="{x:Null}" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut" />
                <BrushTransition Property="CaretBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox#MainTextBox:focus">
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurface}" />
    </Style>

    <Style Selector="TextBox#MainTextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="FontWeight" Value="Regular" />
    </Style>

    <Style Selector="TextBox#MainTextBox ScrollBar:vertical">
        <Setter Property="Width" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.Thumb>
                            <Thumb Name="PART_Thumb" Background="{DynamicResource ScrollBar.ThumbColor}" Width="{StaticResource ScrollBar.ThumbWidth}" CornerRadius="{StaticResource ScrollBar.ThumbRadius}">
                                <Thumb.Styles>
                                    <Style Selector="Thumb:hover">
                                        <Setter Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverColor}" />
                                    </Style>
                                </Thumb.Styles>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>

