<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="core:NetworkBadgeViewModel"
             x:Class="Ecliptix.Core.Controls.Core.NetworkBadgeView">
    <UserControl.Styles>
        <Style Selector="core|StatusBadge.gray">
            <Setter Property="Icon" Value="WifiOff"/>
        </Style>

        <Style Selector="core|StatusBadge.red">
            <Setter Property="Icon" Value="CircleAlert"/>
        </Style>

        <Style Selector="core|StatusBadge.green">
            <Setter Property="Icon" Value="Wifi"/>
        </Style>
    </UserControl.Styles>

    <core:StatusBadge Text="{Binding Text}"
                      Classes.green="{Binding IsConnected}"
                      Classes.gray="{Binding IsDisconnected}"
                      Classes.red="{Binding IsServerError}"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right"/>
</UserControl>

