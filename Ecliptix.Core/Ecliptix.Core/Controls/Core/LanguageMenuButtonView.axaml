<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="core:LanguageMenuButtonViewModel"
             x:Class="Ecliptix.Core.Controls.Core.LanguageMenuButtonView">

    <Border Background="Transparent">
        <Button Command="{Binding OpenLanguagePickerCommand}"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Padding="0,4"
                CornerRadius="8">

            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource Button.Secondary.Hover}" />
                </Style>
            </Button.Styles>

            <Svg Path="{Binding CurrentLanguage.FlagImagePath}"
                 Width="24"
                 Height="24"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        </Button>
    </Border>

</UserControl>

