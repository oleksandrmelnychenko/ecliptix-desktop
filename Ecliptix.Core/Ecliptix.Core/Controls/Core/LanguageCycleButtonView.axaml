<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:Ecliptix.Core.Controls.Core"
             mc:Ignorable="d"
             d:DesignWidth="120"
             d:DesignHeight="36"
             x:Class="Ecliptix.Core.Controls.Core.LanguageCycleButtonView"
             x:DataType="core:LanguageCycleButtonViewModel">

    <UserControl.Styles>
        <Style Selector="Button.language-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.language-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.Secondary.Hover}" />
        </Style>

        <Style Selector="Button.language-toggle:pressed">
            <Setter Property="Background" Value="{DynamicResource Button.Secondary.Pressed}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
    </UserControl.Styles>

    <Button Classes="language-toggle"
            Command="{Binding ToggleLanguageCommand}">
        <Svg Path="{Binding SelectedLanguage.FlagImagePath}"
             VerticalAlignment="Center"
             Width="16"
             Height="11"
             ClipToBounds="True"
             HorizontalAlignment="Center" />
    </Button>
</UserControl>
