<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Core.Views.Memberships.Components.TitleBarUtilities.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ecliptix.Core.Views.Memberships.Components.TitleBarUtilities.Views.ToggleNavigationSideBarView"
             x:DataType="viewModels:ToggleNavigationSideBarViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="PanelLeftIconData">M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 z M9,3 L9,21</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="#1A000000" />
        </Style>

        <Style Selector="Button.icon-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>

        <Style Selector="Button.icon-btn Path">
            <Setter Property="Fill" Value="Transparent" /> <Setter Property="Stroke" Value="#5C5C5C" />  <Setter Property="StrokeThickness" Value="2" /> <Setter Property="StrokeLineCap" Value="Round" /> <Setter Property="StrokeJoin" Value="Round" />    </Style>

        <Style Selector="Button.icon-btn:pointerover Path">
            <Setter Property="Stroke" Value="#242424" /> </Style>
    </UserControl.Styles>

    <Button Classes="icon-btn"
            Width="24" Height="24"
            Command="{Binding ToggleCommand}">

        <Viewbox Width="16" Height="16">
            <Path Data="{StaticResource PanelLeftIconData}"
                  Stretch="Uniform"/>
        </Viewbox>
    </Button>

</UserControl>

