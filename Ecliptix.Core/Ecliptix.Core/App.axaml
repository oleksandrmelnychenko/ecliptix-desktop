<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hintedTextControls="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls"
             xmlns:sharedConverters="clr-namespace:Ecliptix.Core.Shared.Converters"
             x:Class="Ecliptix.Core.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="SegoeUI">avares://Ecliptix.Core/Assets/Fonts/SegoeUI/#Segoe UI</FontFamily>

            <!-- Shared Converters -->
            <sharedConverters:ResourceConverter x:Key="ResourceConverter"/>
            <sharedConverters:BooleanToOpacityConverter x:Key="BoolToOpacityConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/Icons/UI/LampIcon.axaml"></ResourceInclude>
                <ResourceInclude Source="/Styles/Components/CalendarDatePicker.axaml"/>
                <ResourceInclude Source="Controls/Core/Icons/Resources/LucideIconResources.axaml"/>
                <ResourceInclude Source="Controls/Core/Icons/EcliptixIcon.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <StyleInclude Source="/Styles/Core/Colors.axaml" />
        <StyleInclude Source="/Styles/Core/Dimensions.axaml" />
        <StyleInclude Source="/Styles/Components/ScrollBar.axaml"/>
        <StyleInclude Source="/Styles/Core/Typography.axaml" />
        <StyleInclude Source="/Styles/Core/Animations.axaml" />
        <StyleInclude Source="/Styles/Components/ItemControl.axaml"/>

        <StyleInclude Source="/Styles/Components/TrafficLights.axaml" />
        <StyleInclude Source="/Styles/Components/Buttons.axaml" />
        <StyleInclude Source="/Styles/Main/MainStyles.axaml" />

        <Style Selector=":is(TemplatedControl)">
            <Setter Property="FontFamily" Value="{StaticResource SegoeUI}" />
        </Style>

        <Style Selector="TextBlock, AccessText">
            <Setter Property="FontFamily" Value="{StaticResource SegoeUI}" />
        </Style>

        <Style Selector="Run, InlineUIContainer">
            <Setter Property="BaselineAlignment" Value="TextBottom" />
        </Style>

        <Style Selector=":is(UserControl)">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style Selector=":is(Control):focus-visible">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector=":is(Control)">
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style Selector=":is(hintedTextControls|HintedTextBox)">
            <Setter Property="IsTabStop" Value="True" />
        </Style>
        <Style Selector=":is(hintedTextControls|HintedPasswordBox)">
            <Setter Property="IsTabStop" Value="True" />
        </Style>

        <Style Selector="hintedTextControls|HintedTextBox TextBox">
            <Setter Property="IsTabStop" Value="True" />
        </Style>
        <Style Selector="hintedTextControls|HintedPasswordBox TextBox">
            <Setter Property="IsTabStop" Value="True" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

    </Application.Styles>
</Application>
