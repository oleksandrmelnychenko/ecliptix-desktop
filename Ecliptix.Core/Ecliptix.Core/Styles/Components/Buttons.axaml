<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <LinearGradientBrush x:Key="ButtonGlowGradient" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Offset="0" Color="#f97316"/>
            <GradientStop Offset="0.5" Color="#ec4899"/>
            <GradientStop Offset="1" Color="#a855f7"/>
        </LinearGradientBrush>
    </Styles.Resources>

    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button">

        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.00)" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(1.00)" />
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="RenderTransform" Value="scale(1.00)" />
    </Style>

    <Style Selector="Button.primary, Button.secondary">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ClipToBounds="False">

                    <Border Name="PART_Glow"
                            Background="{DynamicResource ButtonGlowGradient}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <BlurEffect Radius="4"/>
                        </Border.Effect>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="False">

                        <Grid ClipToBounds="False">

                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}"/>
                                    </Style>
                                </ContentPresenter.Styles>
                            </ContentPresenter>

                            <Grid Name="PART_LoadingOverlay"
                                  IsVisible="False"
                                  Opacity="0">
                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="26" Height="26" Margin="0 -1 0 0">

                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="2"  Fill="{TemplateBinding Foreground}" Name="Dot1" Opacity="1"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="17" Canvas.Top="5"  Fill="{TemplateBinding Foreground}" Name="Dot2" Opacity="0.85"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="20" Canvas.Top="12" Fill="{TemplateBinding Foreground}" Name="Dot3" Opacity="0.7"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="17" Canvas.Top="19" Fill="{TemplateBinding Foreground}" Name="Dot4" Opacity="0.55"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="22" Fill="{TemplateBinding Foreground}" Name="Dot5" Opacity="0.4"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="3"  Canvas.Top="19" Fill="{TemplateBinding Foreground}" Name="Dot6" Opacity="0.25"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="0"  Canvas.Top="12" Fill="{TemplateBinding Foreground}" Name="Dot7" Opacity="0.15"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="3"  Canvas.Top="5"  Fill="{TemplateBinding Foreground}" Name="Dot8" Opacity="0.1"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0" Color="#111827" />
                    <GradientStop Offset="1" Color="#1f2937" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#ffffff" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}" />
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style Selector="Button.primary /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="0 6 28 0 #4D000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0" Color="#000000" />
                    <GradientStop Offset="1" Color="#111827" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="0 8 32 0 #66000000"/>
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="#f3f4f6" />
        <Setter Property="Foreground" Value="#111827" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource SegoeUI}" />
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="#e5e7eb" />
    </Style>
    <Style Selector="Button.secondary:pressed">
        <Setter Property="Background" Value="#d1d5db" />
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Footer.Link}" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Footer.Link.Hover}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pressed">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Button.large">
        <Setter Property="Height" Value="{StaticResource Button.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource Button.MinWidth}" />
        <Setter Property="FontSize" Value="{StaticResource Button.FontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource Button.CornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Height" Value="{StaticResource Button.SmallHeight}" />
        <Setter Property="FontSize" Value="{StaticResource Button.SmallFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Padding.S}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}" />
    </Style>

    <Style Selector="Button.icon-only">
        <Setter Property="Width" Value="{StaticResource Back.ButtonSize}" />
        <Setter Property="Height" Value="{StaticResource Back.ButtonSize}" />
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Round}" />
    </Style>

    <Style Selector="Button.glow /template/ Border#PART_Glow">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style Selector="Button.glow:pointerover /template/ Border#PART_Glow">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Button.glow:disabled /template/ Border#PART_Glow">
        <Setter Property="Opacity" Value="0.3"/>
    </Style>

    <Style Selector="Button.is-busy">
        <Setter Property="Cursor" Value="Wait"/>
    </Style>

    <Style Selector="Button.is-busy /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.is-busy /template/ Grid#PART_LoadingOverlay">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.is-busy /template/ Ellipse#Dot1">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="12.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="87.5%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot2">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
                <KeyFrame Cue="12.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="25%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot3">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.7"/></KeyFrame>
                <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="37.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.7"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot4">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
                <KeyFrame Cue="37.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot5">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="62.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot6">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                <KeyFrame Cue="62.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="75%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot7">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="75%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="87.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot8">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="87.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost.footer-link">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryUltraBrightVariant}" />
    </Style>

    <Style Selector="Button.ghost.footer-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrightVariant}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost.footer-link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrightVariant}" />
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Button.back-button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#F3F4F6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.back-button Image">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.back-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E5E7EB" />
    </Style>

    <Style Selector="Button.back-button:pointerover Image">
        <Setter Property="RenderTransform" Value="scale(1.1)" />
    </Style>

    <Style Selector="Button.back-button:pressed Image">
        <Setter Property="RenderTransform" Value="scale(0.9)" />
    </Style>
    <Style Selector="Button.back-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D1D5DB" />
    </Style>
</Styles>
