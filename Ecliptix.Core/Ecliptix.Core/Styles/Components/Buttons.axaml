<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <LinearGradientBrush x:Key="ButtonGlowGradient" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Offset="0" Color="#FF8C00"/>
            <GradientStop Offset="1" Color="#FF00FF"/>
        </LinearGradientBrush>
    </Styles.Resources>


    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button">

        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="{StaticResource Duration.Medium}" />
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource Duration.Medium}" />
                <BrushTransition Property="Background" Duration="{StaticResource Duration.Medium}" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.00)" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(1.00)" />
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="RenderTransform" Value="scale(1.00)" />
    </Style>

    <Style Selector="Button.primary, Button.secondary">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ClipToBounds="False">

                    <Border Name="PART_Glow"
                            Background="{DynamicResource ButtonGlowGradient}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="0"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <BlurEffect Radius="20"/>
                        </Border.Effect>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>


                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="False">

                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                            </Transitions>
                        </Border.Transitions>

                        <Grid ClipToBounds="False">

                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />


                            <Grid Name="PART_LoadingOverlay"
                                  IsVisible="False"
                                  Opacity="0">
                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="26" Height="26" Margin="0 -1 0 0">

                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="2"  Fill="{TemplateBinding Foreground}" Name="Dot1" Opacity="1"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="17" Canvas.Top="5"  Fill="{TemplateBinding Foreground}" Name="Dot2" Opacity="0.85"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="20" Canvas.Top="12" Fill="{TemplateBinding Foreground}" Name="Dot3" Opacity="0.7"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="17" Canvas.Top="19" Fill="{TemplateBinding Foreground}" Name="Dot4" Opacity="0.55"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="22" Fill="{TemplateBinding Foreground}" Name="Dot5" Opacity="0.4"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="3"  Canvas.Top="19" Fill="{TemplateBinding Foreground}" Name="Dot6" Opacity="0.25"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="0"  Canvas.Top="12" Fill="{TemplateBinding Foreground}" Name="Dot7" Opacity="0.15"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="3"  Canvas.Top="5"  Fill="{TemplateBinding Foreground}" Name="Dot8" Opacity="0.1"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource Button.Primary.Hover}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource Button.Primary.Pressed}" />
    </Style>


    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource Button.Secondary.Hover}" />
    </Style>
    <Style Selector="Button.secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource Button.Secondary.Pressed}" />
    </Style>


    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Footer.Link}" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Footer.Link.Hover}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pressed">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>


    <Style Selector="Button.large">
        <Setter Property="Height" Value="{StaticResource Button.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource Button.MinWidth}" />
        <Setter Property="FontSize" Value="{StaticResource Button.FontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource Button.CornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Height" Value="{StaticResource Button.SmallHeight}" />
        <Setter Property="FontSize" Value="{StaticResource Button.SmallFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Padding.S}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}" />
    </Style>

    <Style Selector="Button.icon-only">
        <Setter Property="Width" Value="{StaticResource Back.ButtonSize}" />
        <Setter Property="Height" Value="{StaticResource Back.ButtonSize}" />
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Round}" />
    </Style>


    <Style Selector="Button.glow /template/ Border#PART_Glow">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>


    <Style Selector="Button.glow:pointerover">
        <Setter Property="Background" Value="#000000" />
    </Style>
    <Style Selector="Button.glow:pointerover /template/ Border#PART_Glow">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.glow:disabled /template/ Border#PART_Glow">
        <Setter Property="Opacity" Value="0.6"/> <!-- Visible even when disabled -->
    </Style>


    <Style Selector="Button.is-busy">
        <Setter Property="Cursor" Value="Wait"/>
    </Style>


    <Style Selector="Button.is-busy /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.is-busy /template/ Grid#PART_LoadingOverlay">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Button.is-busy /template/ Ellipse#Dot1">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="12.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="87.5%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot2">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
                <KeyFrame Cue="12.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="25%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.85"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot3">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.7"/></KeyFrame>
                <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="37.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.7"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot4">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
                <KeyFrame Cue="37.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot5">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="62.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot6">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                <KeyFrame Cue="62.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="75%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot7">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="75%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="87.5%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.is-busy /template/ Ellipse#Dot8">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
                <KeyFrame Cue="87.5%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.1"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>


    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
