<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:Ecliptix.Feature.Chats.Chats.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ConversationViewModel"
             x:Class="Ecliptix.Feature.Chats.Chats.Views.ChatInputView">

    <UserControl.Resources>
        <system:TimeSpan x:Key="PanelAnimDuration">0:0:0.25</system:TimeSpan>
        <system:Double x:Key="ReplyHeight">46</system:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="/Chats/Styles/ChatStyles.axaml"/>

        <Style Selector="Border.context-panel">
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="15,0,15,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="RenderTransform" Value="translateY(20px)"/>

            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="{StaticResource PanelAnimDuration}" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource PanelAnimDuration}" Easing="LinearEasing"/>
                    <ThicknessTransition Property="Margin" Duration="{StaticResource PanelAnimDuration}" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource PanelAnimDuration}" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.context-panel.open">
            <Setter Property="Height" Value="{StaticResource ReplyHeight}"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Margin" Value="15,0,15,5"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto" VerticalAlignment="Bottom">

        <Border Grid.Row="0"
                x:Name="ContextPanel"
                Classes="context-panel"
                Classes.open="{Binding IsInputContextVisible}"
                Background="White"
                CornerRadius="10"
                BoxShadow="0 2 8 0 #15000000">

            <Grid ColumnDefinitions="4, *, Auto">

                <Border Grid.Column="0"
                        Background="{Binding InputContextColor}"
                        CornerRadius="10,0,0,10"
                        VerticalAlignment="Stretch"/>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" Margin="10,8">
                    <TextBlock Text="{Binding InputContextTitle}"
                               Foreground="{Binding InputContextColor}"
                               FontWeight="SemiBold"
                               FontSize="12"/>

                    <TextBlock Text="{Binding InputContextMessage}"
                               Foreground="#555555"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding CancelInputContextCommand}"
                        Background="Transparent"
                        Padding="10"
                        VerticalAlignment="Top"
                        Cursor="Hand">
                    <PathIcon Data="M13.41,12l4.3-4.29a1,1,0,1,0-1.42-1.42L12,10.59,7.71,6.29A1,1,0,0,0,6.29,7.71L10.59,12l-4.3,4.29a1,1,0,0,0,0,1.42,1,1,0,0,0,1.42,0L12,13.41l4.29,4.3a1,1,0,0,0,1.42,0,1,1,0,0,0,0-1.42Z"
                              Width="10" Height="10" Foreground="#999999"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="input-container">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="56">

                <Button Grid.Column="0" Classes="icon" Margin="10,0,0,0">
                    <PathIcon Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z"
                              Width="20" Height="20" Foreground="Gray"/>
                </Button>

                <TextBox Grid.Column="1" Classes="clean-input"
                         Text="{Binding InputText}"
                         Watermark="Write a message..."
                         VerticalContentAlignment="Center" Margin="5,0"/>

                <Button Grid.Column="2"
                        Command="{Binding SendMessageCommand}"
                        Width="40" Height="40" CornerRadius="20"
                        Background="#6A5ACD" Margin="0,0,8,0">
                    <PathIcon Data="{Binding SendIconData}"
                              Width="18" Height="18" Foreground="White" Margin="2,0,0,0"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

