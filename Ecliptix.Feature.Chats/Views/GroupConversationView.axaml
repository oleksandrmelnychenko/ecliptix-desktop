<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Ecliptix.Feature.Chats.ViewModels"
             xmlns:views="clr-namespace:Ecliptix.Feature.Chats.Views"
             xmlns:msgVm="clr-namespace:Ecliptix.Feature.Chats.ViewModels.Messages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:GroupConversationViewModel"
             x:Class="Ecliptix.Feature.Chats.Views.GroupConversationView">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/ChatStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid.Background>
            <DrawingBrush TileMode="Tile" SourceRect="0,0,32,32" DestinationRect="0,0,32,32" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#406A5ACD">
                        <GeometryDrawing.Geometry><EllipseGeometry Rect="15,15,2,2" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <views:GroupChatHeaderView Grid.Row="0" />

        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Visible"
                      x:Name="ChatScrollViewer">

            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.DataTemplates>

                    <DataTemplate DataType="{x:Type msgVm:DateSeparatorViewModel}">
                        <views:DateSeparatorView />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type msgVm:MessageViewModelBase}">
                        <Grid ColumnDefinitions="Auto, *, Auto">

                            <Border Grid.Column="0" Classes="avatar" IsVisible="{Binding !IsMine}" VerticalAlignment="Top" Margin="0,0,10,0">
                                <Panel>
                                    <PathIcon Data="M12,12 A4,4 0 0,1 12,12" Width="16" Height="16" IsVisible="{Binding SenderAvatar, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Image Source="{Binding SenderAvatar}" Stretch="UniformToFill" IsVisible="{Binding SenderAvatar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Panel>
                            </Border>

                            <StackPanel Grid.Column="1" Classes="msg-container" Classes.mine="{Binding IsMine}">

                                <TextBlock Text="{Binding SenderName}"
                                           FontSize="11"
                                           Foreground="#6E767D"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,2"
                                           IsVisible="{Binding !IsMine}"/>

                                <views:MessageBubbleView />

                            </StackPanel>

                            <Border Grid.Column="2" Classes="avatar" IsVisible="{Binding IsMine}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock Text="ME" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>
                        </Grid>
                    </DataTemplate>

                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <views:ChatInputView Grid.Row="2" />
    </Grid>
</UserControl>

