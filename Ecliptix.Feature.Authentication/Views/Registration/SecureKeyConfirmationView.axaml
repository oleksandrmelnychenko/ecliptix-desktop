<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreControls="clr-namespace:Ecliptix.Core.Controls.Core;assembly=Ecliptix.Core"
             xmlns:hintedTextControls="clr-namespace:Ecliptix.Core.Controls.Core.HintedTextControls;assembly=Ecliptix.Core"
             xmlns:signUp="clr-namespace:Ecliptix.Feature.Authentication.ViewModels.Registration"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="signUp:SecureKeyConfirmationViewModel"
             x:Class="Ecliptix.Feature.Authentication.Views.Registration.SecureKeyConfirmationView"
             MinWidth="{StaticResource Content.MaxWidth}"
             Width="{StaticResource Content.MaxWidth}">
  <UserControl.Styles>
        <Style Selector="Border.tipsBlock">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.tipsBlock.successState">

            <Setter Property="BorderBrush" Value="#10B981"/>
        </Style>

        <Style Selector="TextBlock.requirement">
            <Setter Property="Foreground" Value="#5A5A5A"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.requirement.met">
            <Setter Property="Foreground" Value="#10B981"/>
        </Style>

        <Style Selector="PathIcon.status-icon">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="BackEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="PathIcon.status-icon.cross">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="PathIcon.status-icon.cross.met">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.5)"/>
        </Style>

        <Style Selector="PathIcon.status-icon.check">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.5)"/>
        </Style>
        <Style Selector="PathIcon.status-icon.check.met">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="0 -15 0 0" RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto" RowSpacing="13">
        <StackPanel Grid.Row="0" Spacing="{StaticResource Spacing.S}" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource Font.XL}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource OnSurface}"
                           LineHeight="{StaticResource LineHeight.Loose}" />
                <coreControls:StepBadgeView Text="{Binding StepBadgeText}"
                                            VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource Font.XL}"
                       LineHeight="{StaticResource LineHeight.Subtitle}"
                       FontWeight="Normal"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       />
        </StackPanel>
        <hintedTextControls:HintedPasswordBox
            Grid.Row="1"
            x:Name="SecureKeyTextBox"
            IsSecureKeyMode="True"
            IsSecureKeyStrengthMode="{Binding HasSecureKeyBeenTouched}"
            SecureKeyStrength="{Binding CurrentSecureKeyStrength}"
            SecureKeyStrengthText="{Binding SecureKeyStrengthMessage}"
            Watermark="{Binding  SecureKeyPlaceholder}"
            Hint="{Binding SecureKeyHint}"
            ErrorText="{Binding SecureKeyError, Mode=OneWay}"
            HasError="{Binding HasSecureKeyError, Mode=OneWay}"
            Height="{StaticResource Input.SecureHeight}"
            CornerRadius="{StaticResource Input.CornerRadius}"
            FontSize="{StaticResource Input.SecureFontSize}"
            FontWeight="Light"
            TextForeground="{DynamicResource OnSurface}"
            HintForeground="{DynamicResource Primary}"
            MaxLength="28"
            VisualIcon="Lock"/>

        <hintedTextControls:HintedPasswordBox
            Grid.Row="2"
            x:Name="VerifySecureKeyTextBox"
            IsSecureKeyMode="True"
            Watermark="{Binding VerifySecureKeyPlaceholder}"
            Hint="{Binding VerifySecureKeyHint}"
            ErrorText="{Binding VerifySecureKeyError, Mode=OneWay}"
            HasError="{Binding HasVerifySecureKeyError, Mode=OneWay}"
            Height="{StaticResource Input.SecureHeight}"
            CornerRadius="{StaticResource Input.CornerRadius}"
            FontSize="{StaticResource Input.SecureFontSize}"
            FontWeight="Light"
            TextForeground="{DynamicResource OnSurface}"
            HintForeground="{DynamicResource Primary}"
            MaxLength="28"
            VisualIcon="LockKeyhole"/>

     <Border Grid.Row="3"
                Classes="tipsBlock"
                Classes.successState="{Binding IsSecureKeySuccess}"
                CornerRadius="12"
                Padding="12,12"
                Margin="0,4">

            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Panel Width="16" Height="16" VerticalAlignment="Center">
                        <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                  Foreground="#9747FF"
                                  Width="16" Height="16"
                                  IsVisible="{Binding !IsSecureKeySuccess}"/>
                        <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                  Foreground="#10B981"
                                  Width="16" Height="16"
                                  IsVisible="{Binding IsSecureKeySuccess}"/>
                    </Panel>

                    <TextBlock IsVisible="{Binding !IsSecureKeySuccess}"
                               Text="{Binding RequirementsTitle}"
                               Foreground="#9747FF"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <TextBlock IsVisible="{Binding IsSecureKeySuccess}"
                               Text="{Binding RequirementsSuccessTitle}"
                               Foreground="#10B981"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding ValidationTips}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"
                                         VerticalAlignment="Top"
                                         HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,3,4,3">

                                <Panel Grid.Column="0"
                                       Width="12" Height="12"
                                       VerticalAlignment="Top"
                                       Margin="0,2,8,0">

                                    <PathIcon Classes="status-icon cross"
                                              Classes.met="{Binding IsMet}"
                                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                              Foreground="#FF6B6B"
                                              Width="9" Height="9"/>

                                    <PathIcon Classes="status-icon check"
                                              Classes.met="{Binding IsMet}"
                                              Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Foreground="#10B981"
                                              Width="10" Height="10"/>
                                </Panel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           Classes="requirement"
                                           Classes.met="{Binding IsMet}"
                                           TextWrapping="Wrap"
                                           FontSize="11.5"
                                           LineHeight="15"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Button
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            Height="{StaticResource Button.Height}"
            FontWeight="Medium"
            FontSize="{StaticResource Button.FontSize}"
            CornerRadius="{StaticResource Button.CornerRadius}"
            BorderThickness="0"
            Background="{DynamicResource Secondary}"
            Foreground="{DynamicResource OnSecondary}"
            Command="{Binding SubmitCommand}"
            Content="{Binding ButtonText}"
            IsEnabled="{Binding CanSubmit}"
            Classes="primary large glow"
            Classes.is-busy="{Binding IsBusy}"
            />
        <coreControls:ErrorNotificationView
            Grid.Row="5"
            x:Name="ErrorNotification"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,0"/>
    </Grid>
</UserControl>
